<style>
  .trust-ribbon {
    --trust-ribbon-bg-start: #0d1535;
    --trust-ribbon-bg-mid: #1a3a8f;
    --trust-ribbon-bg-end: #0d1535;
    --trust-ribbon-gold-soft: rgba(201, 168, 76, 0.3);
    box-sizing: border-box;
    position: relative;
    width: auto;
    margin-inline: calc(50% - 50vw);
    
    border-top: 1px solid var(--color-deco-gold, #c9a84c);
    border-bottom: 1px solid var(--color-deco-gold, #c9a84c);
    padding: 2.8rem 2rem;
    text-align: center;
    overflow: hidden;
  }

  .trust-ribbon::before,
  .trust-ribbon::after {
    content: '';
    position: absolute;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--trust-ribbon-gold-soft);
  }

  .trust-ribbon::before { left: 24px; }
  .trust-ribbon::after { right: 24px; }

  .trust-ribbon__heading {
    font-size: clamp(1.6rem, 2vw, 2rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-deco-gold, #c9a84c);
    margin: 0 0 1.8rem;
  }

  .trust-ribbon__img {
    display: block;
    margin: 0 auto;
    width: min(880px, 90vw);
    height: auto;
  }
</style>

<section class="trust-ribbon">
  <h2 class="trust-ribbon__heading">Shop With Confidence</h2>
  {% if section.settings.trust_image %}
    {% assign trust_image_width = 880 %}
    {% assign trust_image_height = section.settings.trust_image.height | times: trust_image_width | divided_by: section.settings.trust_image.width %}
    <picture>
      <source
        srcset="{{ section.settings.trust_image | image_url: width: 1760, format: 'webp' }}"
        type="image/webp"
        media="(min-width: 768px)"
      >
      <img
        class="trust-ribbon__img"
        src="{{ section.settings.trust_image | image_url: width: 880, format: 'webp' }}"
        alt="{{ section.settings.alt_text | escape | default: 'Trust Badges: Gamer Designed, Wellness, Secure, Support' }}"
        width="{{ trust_image_width }}"
        height="{{ trust_image_height }}"
        loading="lazy"
      >
    </picture>
  {% else %}
    <p style="color:var(--color-deco-gold,#c9a84c);margin:0;">Upload your trust badges image in the section settings.</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Trust Badges",
  "settings": [
    {
      "type": "image_picker",
      "id": "trust_image",
      "label": "Trust badges image"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image alt text",
      "default": "Trust Badges: Gamer Designed, Wellness, Secure, Support"
    }
  ],
  "presets": [
    {
      "name": "Trust Badges"
    }
  ]
}
{% endschema %}
