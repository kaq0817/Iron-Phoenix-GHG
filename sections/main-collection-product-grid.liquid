{%- comment -%}
  Product Grid with BLOCK-BASED Navigation (allows for dynamic ordering/adding of links)
  - Displays up to 3 linked collections via Section Blocks
  - Iron Phoenix color scheme and SEO structure
{%- endcomment -%}

<style>
  .collection-section {
    background: #111111;
    min-height: 100vh;
    padding: 40px 20px;
  }

  .collection-nav {
    text-align: center;
    margin-bottom: 40px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .collection-nav a {
    color: #fff;
    text-decoration: none;
    padding: 8px 16px;
    font-size: 16px;
    font-weight: 600;
    border-radius: 8px;
    transition: all 0.3s ease;
  }

  .collection-nav a:hover {
    color: #ffff33;
    border-bottom: 2px solid #ffff33;
  }

  .collection-nav a.active {
    color: #C9A84C;
    border-bottom: 2px solid #C9A84C;
  }

  .collection-hero {
    text-align: center;
    margin-bottom: 40px;
  }

  .collection-hero h1 {
    color: #fff;
    font-size: 36px;
    margin-bottom: 10px;
  }

  .product-count {
    color: rgba(255,255,255,0.6);
    font-size: 14px;
  }

  /* HIDE DESCRIPTION - Keep in HTML for SEO */
  .collection-description {
    display: none!important;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .products-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .products-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .product-item {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s;
  }

  .product-item:hover {
    transform: translateY(-5px);
    border-color: #C9A84C;
    box-shadow: 0 10px 30px rgba(201, 168, 76,0.2);
  }

  .product-link {
    text-decoration: none;
    display: block;
    color: inherit;
  }

  .product-image-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background: #0a0a0a;
  }

  .product-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sale-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #ff0066;
    color: #fff;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    z-index: 1;
  }

  .product-info {
    padding: 15px;
  }

  .product-vendor {
    color: rgba(255,255,255,0.5);
    font-size: 12px;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .product-title {
    color: #fff;
    font-size: 15px;
    margin-bottom: 10px;
    font-weight: 600;
    line-height: 1.4;
    min-height: 42px;
  }

  .price-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .product-price {
    color: #C9A84C;
    font-size: 18px;
    font-weight: 700;
  }

  .compare-price {
    color: rgba(255,255,255,0.4);
    font-size: 14px;
    text-decoration: line-through;
  }

  .pagination {
    text-align: center;
    margin-top: 50px;
  }

  .pagination a,
  .pagination.current {
    color: #fff;
    padding: 10px 15px;
    margin: 0 5px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    text-decoration: none;
    display: inline-block;
  }

  .pagination.current {
    background: #C9A84C;
    color: #000;
    border-color: #C9A84C;
  }

  .collection-empty {
    text-align: center;
    padding: 60px 20px;
    color: #fff;
  }
</style>

<div class="collection-section" role="main">
  <div class="page-width">

    <nav class="collection-nav" role="navigation" aria-label="Collection categories">
      {%- comment -%} ITERATE OVER BLOCKS FOR NAVIGATION LINKS {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- assign linked_col = block.settings.linked_collection -%}
        
        {%- if linked_col and linked_col.title -%}
          <a href="{{ linked_col.url }}"
             {% if collection.id == linked_col.id %}class="active" aria-current="page"{% endif %}>
            {{ linked_col.title }}
          </a>
        {%- endif -%}
      {%- endfor -%}
      {%- comment -%} NOTE: Original Metafield logic removed as it's not compatible with block structure {%- endcomment -%}
    </nav>

    <header class="collection-hero">
      <h1>{{ collection.title }}</h1>
      <p class="product-count">
        <span>{{ collection.products_count }}</span>
        {% if collection.products_count == 1 %}product{% else %}products{% endif %}
      </p>
      {% if collection.description != blank %}
        <div class="collection-description">
          {{ collection.description }}
        </div>
      {% endif %}
    </header>

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products_count > 0 -%}
        <section class="products-grid" role="list" aria-label="Products">
          {%- for product in collection.products -%}
            <article class="product-item" role="listitem" itemscope itemtype="https://schema.org/Product">
              <a href="{{ product.url | within: collection }}" class="product-link">

                <div class="product-image-wrapper">
                  {%- if product.featured_image -%}
                    <img
                      class="product-image"
                      src="{{ product.featured_image | image_url: width: 400 }}"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      width="400"
                      height="400"
                      loading="lazy"
                      itemprop="image">
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'product-image' }}
                  {%- endif -%}

                  {%- if product.compare_at_price > product.price -%}
                    <span class="sale-badge">SALE</span>
                  {%- endif -%}
                </div>

                <div class="product-info">
                  {%- if section.settings.show_vendor and product.vendor != blank -%}
                    <div class="product-vendor" itemprop="brand">{{ product.vendor }}</div>
                  {%- endif -%}

                  <h2 class="product-title" itemprop="name">{{ product.title | truncate: 50 }}</h2>

                  <div class="price-wrapper" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                    <meta itemprop="priceCurrency" content="{{ shop.currency }}">
                    <meta itemprop="price" content="{{ product.price | money_without_currency | remove: ',' }}">
                    <link itemprop="availability" href="https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}">
                    <span class="product-price">{{ product.price | money }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <span class="compare-price">{{ product.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>
                </div>
              </a>
            </article>
          {%- endfor -%}
        </section>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" role="navigation">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" rel="prev">←</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                {%- if part.title == '&hellip;' -%}
                  <span>...</span>
                {%- else -%}
                  <span class="current">{{ part.title }}</span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" rel="next">→</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="collection-empty">
          <h2>No products found</h2>
          <p>Try adjusting your filters or
            <a href="{{ routes.all_products_collection_url }}" style="color:#C9A84C;">browse all products</a>
          </p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Product Grid",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show product vendor"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 50,
      "step": 2,
      "default": 16,
      "label": "Products per page"
    }
  ],
  "blocks": [
    {
      "type": "sub_collection_link",
      "name": "Collection Link",
      "settings": [
        {
          "type": "collection",
          "id": "linked_collection",
          "label": "Select Collection"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Default Product Grid",
      "blocks": [
        { "type": "sub_collection_link" },
        { "type": "sub_collection_link" }
      ]
    }
  ]
}
{% endschema %}