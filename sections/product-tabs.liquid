{%- comment -%}
  Go Hard Gaming Discord LLC — Auto Product Tabs (Compliant Dynamic Splitter)
  - Automatically converts H3 Headers in your Product Description into crisp tabs.
  - Handles Shopify-injected tag variables (IDs, classes) smoothly.
{%- endcomment -%}

<style>
  .product-tabs-section {
    margin: 4rem auto;
    max-width: 140rem;
    padding: 0 2rem;
  }

  .tabs-nav {
    display: flex;
    border-bottom: 3px solid #6B2737;
    margin-bottom: 2rem;
    overflow-x: auto; 
    gap: 4px;
  }

  .tab-btn {
    background: transparent;
    border: none;
    padding: 1.5rem 2.5rem;
    font-size: 1.6rem;
    font-weight: 700;
    color: #F3E6D8;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
    border-bottom: 4px solid transparent;
    margin-bottom: -3px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .tab-btn:hover {
    color: #6B2737;
  }

  .tab-btn.active {
    color: #6B2737;
    border-bottom: 4px solid #6B2737;
  }

  .tab-content {
    display: none;
    font-size: 1.6rem;
    line-height: 1.7;
    color: #F3E6D8 !important;
    padding: 2rem 0;
    text-align: left !important;
  }

  .tab-content.active {
    display: block;
  }

  /* Force every single element inside the tab content to use the readable cream color */
  .tab-content, .tab-content *, .tab-content p, .tab-content span, .tab-content li {
    color: #F3E6D8 !important;
  }

  .tab-content h3, 
  .tab-content [class*="heading"] { 
    display: none !important; 
  } 
  
  .tab-content ul { 
    padding-left: 2rem !important; 
    margin-bottom: 1.5rem !important; 
  }
  
  .tab-content p { 
    margin-bottom: 1.5rem !important; 
  }
</style>

<div class="product-tabs-section page-width">
  {%- if product.description != blank -%}
    
    {%- liquid
      assign normalized_desc = product.description | replace: '<H3', '<h3' | replace: ' </h3', '</h3'
      assign base_description = normalized_desc | split: '<h3' | first
      assign raw_tab_chunks = normalized_desc | replace: '<h3', '|||SPLIT|||' | split: '|||SPLIT|||'
    -%}
    
    <div class="tabs-nav" role="tablist">
      <button class="tab-btn active" onclick="openProductTab(event, 'prod-tab-0')">Description</button>

      {%- for chunk in raw_tab_chunks -%}
        {%- unless forloop.first -%}
          {%- liquid
            assign clean_chunk = chunk | replace: '</h3>', '|||HEADEREND|||'
            assign chunk_parts = clean_chunk | split: '|||HEADEREND|||'
            assign tab_title = chunk_parts.first | split: '>' | last | strip_html | strip
          -%}
          {%- if tab_title != blank -%}
            <button class="tab-btn" onclick="openProductTab(event, 'prod-tab-{{ forloop.index0 }}')">{{ tab_title }}</button>
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>

    <div class="tabs-content-wrapper">
      <div id="prod-tab-0" class="tab-content active rte">
        {{ base_description }}
      </div>

      {%- for chunk in raw_tab_chunks -%}
        {%- unless forloop.first -%}
          {%- liquid
            assign clean_chunk = chunk | replace: '</h3>', '|||HEADEREND|||'
            assign chunk_parts = clean_chunk | split: '|||HEADEREND|||'
            assign tab_content = chunk_parts.last | strip
          -%}
          <div id="prod-tab-{{ forloop.index0 }}" class="tab-content rte">
            {{ tab_content }}
          </div>
        {%- endunless -%}
      {%- endfor -%}
    </div>

  {%- endif -%}
</div>

<script>
  function openProductTab(evt, tabId) {
    var i, tabcontent, tablinks;
    
    tabcontent = document.getElementsByClassName("tab-content");
    for (i = 0; i < tabcontent.length; i++) {
      tabcontent[i].style.display = "none";
      tabcontent[i].classList.remove("active");
    }

    tablinks = document.getElementsByClassName("tab-btn");
    for (i = 0; i < tablinks.length; i++) {
      tablinks[i].classList.remove("active");
    }

    var selectedTab = document.getElementById(tabId);
    if (selectedTab) {
      selectedTab.style.display = "block";
      selectedTab.classList.add("active");
    }
    evt.currentTarget.classList.add("active");
  }
</script>

{% schema %}
{
  "name": "Auto Product Tabs",
  "settings": [],
  "presets": [{ "name": "Auto Product Tabs" }]
}
{% endschema %}