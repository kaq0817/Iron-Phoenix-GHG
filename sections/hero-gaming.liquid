{%- comment -%} /sections/hero-gaming.liquid — Neon gaming hero {%- endcomment -%}
<section class="hero-gaming page-width color-{{ section.settings.color_scheme }}">
  <div class="hero-gaming__bg" aria-hidden="true"></div>
  <div class="hero-gaming__wrap">
    <div class="hero-gaming__copy">
      <div class="hero-gaming__eyebrow">{{ section.settings.eyebrow | default: 'Iron Phoenix GHG' | escape }}</div>
      <h1 class="hero-gaming__title">{{ section.settings.heading | default: 'Level up your gear.' | escape }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="hero-gaming__subtitle">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      <div style="margin-top:1.25rem;display:flex;gap:1rem;flex-wrap:wrap;">
        {% render 'cta-powerup', href: section.settings.primary_link, label: section.settings.primary_label, icon: 'bolt' %}
        {%- if section.settings.secondary_label and section.settings.secondary_link -%}
          <a href="{{ section.settings.secondary_link }}" class="badge-chip">{{ section.settings.secondary_label | escape }}</a>
        {%- endif -%}
      </div>
      <div style="margin-top:1.25rem;">
        {%- if snippet_exists 'vip-xp-bar' -%}{% render 'vip-xp-bar' %}{%- endif -%}
      </div>
    </div>

    {%- if section.settings.image != blank -%}
      <div class="hero-gaming__media">
        {%- if snippet_exists 'optimized-image' -%}
          {% render 'optimized-image',
            image: section.settings.image,
            alt: section.settings.image_alt | default: section.settings.heading,
            widths: '480,720,960,1200,1600',
            sizes: '(max-width: 980px) 100vw, 46vw',
            loading: 'eager',
            fetchpriority: 'high'
          %}
        {%- else -%}
          {{ section.settings.image
             | image_url: width: 1600
             | image_tag: widths: '480,720,960,1200,1600', sizes: '(max-width: 980px) 100vw, 46vw',
               alt: section.settings.image_alt | default: section.settings.heading, loading: 'eager', fetchpriority: 'high' }}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero — Gaming Neon",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Iron Phoenix GHG" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Level up your gear." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Custom gaming apparel and accessories designed to perform." },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "image_alt", "label": "Hero image alt", "default": "Gaming showcase" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop New Drops" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "See VIP perks" }
  ],
  "presets": [{ "name": "Hero — Gaming Neon" }]
}
{% endschema %}
