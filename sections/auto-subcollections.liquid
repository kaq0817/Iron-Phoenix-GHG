{%- comment -%}
  Auto-SubCollections Section
  • Dynamically shows linked sub-collections for *the current collection*
  • Uses metafields:
      custom.collection_1, custom.collection_2, custom.collection_3 (collection references)
  • Works on every collection page, no manual setup needed
{%- endcomment -%}
{%- style -%}
  .auto-subcols-{{ section.id }} {
    max-width: 1200px;
    margin: 0 auto 40px;
    padding: 0 1rem;
  }
  .auto-subcols-heading {
    text-align: center;
    font-size: 1.8rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 1.5rem;
  }
  .auto-subcols-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
  }
  .auto-subcols-card {
    width: 260px;
    height: 240px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    text-align: center;
    text-decoration: none;
    color: #fff;
    overflow: hidden;
    transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
  }
  .auto-subcols-card:hover {
    transform: translateY(-6px);
    border-color: #00f5ff;
    box-shadow: 0 10px 25px rgba(0,245,255,0.25);
  }
  .auto-subcols-card img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    display: block;
  }
  .auto-subcols-card h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 10px 0;
    line-height: 1.2;
  }
  @media (max-width: 768px) {
    .auto-subcols-card { width: 45%; height: auto; }
    .auto-subcols-card img { height: 130px; }
  }
{%- endstyle -%}
{%- assign c1 = collection.metafields.custom.collection_1.reference -%}
{%- assign c2 = collection.metafields.custom.collection_2.reference -%}
{%- assign c3 = collection.metafields.custom.collection_3.reference -%}
{%- if c1 or c2 or c3 -%}
  <div class="auto-subcols-{{ section.id }}">
    <h2 class="auto-subcols-heading">Shop Related Collections</h2>
    <div class="auto-subcols-row">
      {%- if c1 and c1.handle -%}
        <a href="{{ c1.url }}" class="auto-subcols-card" aria-label="{{ c1.title }}">
          {% if c1.image %}
            <img src="{{ c1.image | image_url: width: 800 }}"
                 srcset="{{ c1.image | image_url: width: 400 }} 400w, {{ c1.image | image_url: width: 800 }} 800w"
                 sizes="(max-width: 749px) 100vw, 33vw"
                 alt="{{ c1.title | escape }}" width="800" height="{{ 800 | divided_by: c1.image.aspect_ratio | round }}" loading="lazy">
          {% endif %}
          <h3>{{ c1.title }}</h3>
        </a>
      {%- endif -%}
      {%- if c2 and c2.handle -%}
        <a href="{{ c2.url }}" class="auto-subcols-card" aria-label="{{ c2.title }}">
          {% if c2.image %}
            <img src="{{ c2.image | image_url: width: 800 }}"
                 srcset="{{ c2.image | image_url: width: 400 }} 400w, {{ c2.image | image_url: width: 800 }} 800w"
                 sizes="(max-width: 749px) 100vw, 33vw"
                 alt="{{ c2.title | escape }}" width="800" height="{{ 800 | divided_by: c2.image.aspect_ratio | round }}" loading="lazy">
          {% endif %}
          <h3>{{ c2.title }}</h3>
        </a>
      {%- endif -%}
      {%- if c3 and c3.handle -%}
        <a href="{{ c3.url }}" class="auto-subcols-card" aria-label="{{ c3.title }}">
          {% if c3.image %}
            <img src="{{ c3.image | image_url: width: 800 }}"
                 srcset="{{ c3.image | image_url: width: 400 }} 400w, {{ c3.image | image_url: width: 800 }} 800w"
                 sizes="(max-width: 749px) 100vw, 33vw"
                 alt="{{ c3.title | escape }}" width="800" height="{{ 800 | divided_by: c3.image.aspect_ratio | round }}" loading="lazy">
          {% endif %}
          <h3>{{ c3.title }}</h3>
        </a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Auto Sub-Collections",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Auto Sub-Collections" }]
}
{% endschema %}