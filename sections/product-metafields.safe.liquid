{%- comment -%}
/sections/product-metafields.safe.liquid
Iron Phoenix GHG — Safe product metafields renderer
- Escapes all customer-controlled strings (already done!)
- Externalized CSS; no inline styles.
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'section-product-metafields-safe.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'section-product-metafields-safe.css' | asset_url | stylesheet_tag }}</noscript>

{%- assign mf = product.metafields.custom -%}

<section class="product-metafields color-{{ section.settings.color_scheme }}">
  {%- if section.settings.show_short and mf and mf.short_copy and mf.short_copy.value != blank -%}
    <div class="product-metafields__short">
      {%- if section.settings.short_heading != blank -%}
        <h2 class="product-metafields__title">{{ section.settings.short_heading | escape }}</h2>
      {%- endif -%}
      <p class="product-metafields__text">
        {{ mf.short_copy.value | strip | escape | newline_to_br }}
      </p>
    </div>
  {%- endif -%}

  {%- if section.settings.show_traits and mf -%}
    {%- assign fit = mf.male_female_unisex -%}
    {%- assign color = mf.google_color -%}
    {%- if fit != blank or color != blank -%}
      <dl class="product-metafields__traits">
        {%- if fit != blank -%}
          <div class="product-metafields__row">
            <dt class="product-metafields__key">{{ section.settings.fit_label | default: 'Fit' | escape }}</dt>
            <dd class="product-metafields__val">{{ fit | escape }}</dd>
          </div>
        {%- endif -%}
        {%- if color != blank -%}
          <div class="product-metafields__row">
            <dt class="product-metafields__key">{{ section.settings.color_label | default: 'Color' | escape }}</dt>
            <dd class="product-metafields__val">{{ color | escape }}</dd>
          </div>
        {%- endif -%}
      </dl>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product metafields (safe)",
  "class": "section-product-metafields-safe",
  "settings": [
    { "type": "checkbox", "id": "show_short",  "label": "Show short copy", "default": true },
    { "type": "text",     "id": "short_heading", "label": "Short copy heading", "default": "Highlights" },

    { "type": "checkbox", "id": "show_traits", "label": "Show traits (fit/color)", "default": true },
    { "type": "text",     "id": "fit_label",  "label": "Fit label",   "default": "Fit" },
    { "type": "text",     "id": "color_label","label": "Color label", "default": "Color" },

    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" }
  ],
  "presets": [{ "name": "Product metafields (safe)" }]
}
{% endschema %}