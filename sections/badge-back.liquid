<!-- /sections/badge-pack.liquid -->
{% comment %}
  Badge Pack Section for Iron Phoenix GHG
  Displays trust/safety badges to build credibility
  Styles live in assets/badge-pack.css
{% endcomment %}

{{ 'badge-pack.css' | asset_url | stylesheet_tag }}

<section class="badge-pack color-{{ section.settings.color_scheme }}">
  <div class="badge-pack__wrapper page-width">
    <h2 class="badge-pack__heading">{{ section.settings.heading | escape }}</h2>
    <ul class="badge-pack__list" role="list">
      {% for i in (1..5) %}
        {% assign txt_key = 'item_' | append: i %}
        {% assign txt = section.settings[txt_key] %}
        {% if txt != blank %}
          <li class="badge-pack__item">{{ txt }}</li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Badge Pack",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why shop with us?" },
    { "type": "text", "id": "item_1", "label": "Badge #1", "default": "✅ Secure Checkout" },
    { "type": "text", "id": "item_2", "label": "Badge #2", "default": "📦 Fast US Shipping" },
    { "type": "text", "id": "item_3", "label": "Badge #3", "default": "🎁 Exclusive Designs" },
    { "type": "text", "id": "item_4", "label": "Badge #4", "default": "🧠 Mental Health-Focused Brand" },

  ],
  "presets": [{ "name": "Badge Pack" }]
}
{% endschema %}
