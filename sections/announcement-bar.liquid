{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

<style>
  .utility-bar,
  .utility-bar--bottom-border {
    border: 0 !important;
    box-shadow: none !important;
  }

  .utility-bar::before,
  .utility-bar::after {
    display: none !important;
  }

  .announcement-bar {
    padding-top: 0.45rem;
    padding-bottom: 0.45rem;
  }
</style>

{%- assign social_icons = false -%}
{%- if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_tiktok_link != blank or settings.social_twitter_link != blank or settings.social_pinterest_link != blank or settings.social_snapchat_link != blank or settings.social_tumblr_link != blank or settings.social_vimeo_link != blank -%}
  {%- assign social_icons = true -%}
{%- endif -%}

{%- assign localization_enabled = false -%}
{%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
  {%- assign localization_enabled = true -%}
{%- endif -%}

{%- assign announcement_bar = false -%}
{%- unless section.blocks.size > 0 -%}
  {%- assign announcement_bar = true -%}
  {%- capture default_text -%}Welcome to Forged Phoenix – Shop Now!{%- endcapture -%}
{%- else -%}
  {%- assign announcement_bar = true -%}
{%- endunless -%}

{%- assign has_side = false -%}
{%- if localization_enabled or social_icons -%}
  {%- assign has_side = true -%}
{%- endif -%}

{%- assign should_show_border = false -%}
{%- if section.settings.show_line_separator -%}
  {%- if announcement_bar or social_icons -%}
    {%- assign should_show_border = true -%}
  {%- endif -%}
{%- endif -%}

<div class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if should_show_border %} utility-bar--bottom-border{% endif %}{% if localization_enabled %} header-localization{% endif %}">
  <div class="page-width utility-bar__grid{% if announcement_bar and has_side %} utility-bar__grid--3-col{% elsif has_side %} utility-bar__grid--2-col{% endif %}">

    {%- if section.settings.show_social and social_icons -%}
      {%- render 'social-icons' -%}
    {%- endif -%}

    {%- if section.blocks.size == 0 -%}
      <div class="announcement-bar" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
        <div>
          <p class="announcement-bar__message h5">
            <span>{{ default_text | escape }}</span>
          </p>
        </div>
      </div>
    {%- elsif section.blocks.size == 1 -%}
      <div class="announcement-bar" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
        {%- assign blk = section.blocks.first -%}
        <div {{ blk.shopify_attributes }}>
          {%- if blk.settings.text != blank -%}
            {%- if blk.settings.link != blank -%}
              <a href="{{ blk.settings.link }}" class="announcement-bar__link link link--text focus-inset animate-arrow">
            {%- endif -%}
              <p class="announcement-bar__message h5">
                <span>{{ blk.settings.text | escape }}</span>
                {%- if blk.settings.link != blank -%}{{ 'icon-arrow.svg' | inline_asset_content }}{%- endif -%}
              </p>
            {%- if blk.settings.link != blank -%}</a>{%- endif -%}
          {%- endif -%}
        </div>
      </div>
    {%- elsif section.blocks.size > 1 -%}
      <slideshow-component class="announcement-bar"
        role="region"
        aria-roledescription="{{ 'sections.announcements.carousel' | t }}"
        aria-label="{{ 'sections.announcements.announcement_bar' | t }}"
        data-autoplay="{{ section.settings.auto_rotate }}"
        data-speed="{{ section.settings.change_slides_speed }}">
        <div class="announcement-bar-slider slider-buttons">
          <button type="button" class="slider-button slider-button--prev" name="previous"
            aria-label="{{ 'sections.announcements.previous_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}">
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>

          <div class="grid grid--1-col slider slider--everywhere"
               id="Slider-{{ section.id }}"
               aria-live="polite"
               aria-atomic="true">
            {%- for block in section.blocks -%}
              <div class="slideshow__slide slider__slide grid__item grid--1-col"
                   id="Slide-{{ section.id }}-{{ forloop.index }}"
                   {{ block.shopify_attributes }}
                   role="group"
                   aria-roledescription="{{ 'sections.announcements.announcement' | t }}"
                   aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                   tabindex="-1">
                <div class="announcement-bar__announcement" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
                  {%- if block.settings.text != blank -%}
                    {%- if block.settings.link != blank -%}
                      <a href="{{ block.settings.link }}" class="announcement-bar__link link link--text focus-inset animate-arrow">
                    {%- endif -%}
                      <p class="announcement-bar__message h5">
                        <span>{{ block.settings.text | escape }}</span>
                        {%- if block.settings.link != blank -%}{{ 'icon-arrow.svg' | inline_asset_content }}{%- endif -%}
                      </p>
                    {%- if block.settings.link != blank -%}</a>{%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>

          <button type="button" class="slider-button slider-button--next" name="next"
            aria-label="{{ 'sections.announcements.next_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}">
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
        </div>
      </slideshow-component>
    {%- endif -%}

    <div class="localization-wrapper">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}

      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
class SlideshowComponent extends HTMLElement {
  constructor(){
    super();
    this.slider = this.querySelector('.slider');
    this.items = this.querySelectorAll('.slider__slide');
    this.prev = this.querySelector('.slider-button--prev');
    this.next = this.querySelector('.slider-button--next');
    this.enableAuto = this.dataset.autoplay === 'true';
    this.ms = (parseInt(this.dataset.speed || 5, 10)) * 1000;
    if (!this.slider || this.items.length < 1) return;
    this.i = 0; this.n = this.items.length;
    this.init();
  }
  init(){
    if (this.prev && this.next){
      this.onPrev = () => { this.show(this.i-1); this.resetAuto(); };
      this.onNext = () => { this.show(this.i+1); this.resetAuto(); };
      this.prev.addEventListener('click', this.onPrev);
      this.next.addEventListener('click', this.onNext);
    }
    this.show(this.i);
    this.setupAuto();
    this.updateButtons();
  }
  show(idx){
    if (this.n <= 1){ this.items[0]?.classList.add('is-selected'); this.items[0]?.setAttribute('aria-hidden','false'); return; }
    this.items[this.i]?.classList.remove('is-selected'); this.items[this.i]?.setAttribute('aria-hidden','true');
    this.i = (idx < 0) ? this.n-1 : (idx >= this.n ? 0 : idx);
    const cur = this.items[this.i]; cur?.classList.add('is-selected'); cur?.setAttribute('aria-hidden','false'); cur?.focus();
  }
  setupAuto(){ if (this.enableAuto && this.n>1) this.t = setInterval(() => this.show(this.i+1), this.ms); }
  resetAuto(){ clearInterval(this.t); if (this.enableAuto && this.n>1) this.t = setInterval(() => this.show(this.i+1), this.ms); }
  updateButtons(){ const hide = this.n <= 1; this.prev?.toggleAttribute('hidden', hide); this.next?.toggleAttribute('hidden', hide); }
  disconnectedCallback(){ clearInterval(this.t); this.prev?.removeEventListener('click', this.onPrev); this.next?.removeEventListener('click', this.onNext); }
}
customElements.get('slideshow-component') || customElements.define('slideshow-component', SlideshowComponent);

class LocalizationForm extends HTMLElement {
  constructor(){ super(); this.details = this.querySelector('details'); this.details && this.details.addEventListener('toggle', this.onToggle.bind(this)); }
  onToggle(){
    if (!this.details.open) return;
    const onDocToggle = (e) => { if (e.target.closest('details') === this.details) return; document.removeEventListener('toggle', onDocToggle, true); this.close(); };
    document.addEventListener('toggle', onDocToggle, true);
  }
  close(){ this.details.open=false; this.details.querySelector('summary')?.focus(); }
}
customElements.get('localization-form') || customElements.define('localization-form', LocalizationForm);
</script>

{% schema %}
{
  "name": "Mega Announcement Bar",
  "class": "announcement-bar-section",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 12,
  "settings": [
    { "type": "checkbox", "id": "auto_rotate", "label": "Auto rotate", "default": false },
    { "type": "range", "id": "change_slides_speed", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Slide speed", "default": 5 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "show_line_separator", "label": "Show separator line", "default": false },
    { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": false },
    { "type": "checkbox", "id": "enable_country_selector", "label": "Enable country selector", "default": false },
    { "type": "checkbox", "id": "enable_language_selector", "label": "Enable language selector", "default": false }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Announcement text", "default": "Welcome to Forged Phoenix – Shop Now!" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Mega Announcement", "blocks": [{ "type": "announcement" }] }]
}
{% endschema %}