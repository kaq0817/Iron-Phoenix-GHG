{% comment %}
Departments Hub (Flex)
- Build a homepage “department store” with variable child counts per department.
- Each block = one department (e.g., Gaming, Sports & Wellness, Holidays, Suno Music, Downloads).
- Child links source (pick one per block):
  1) Menu (link_list)
  2) Metafield on a parent collection -> navigation.subcollections (List of collections)
  3) Manual list of collections
- Styles externalized to assets/section-departments-hub-flex.css
{% endcomment %}

<link rel="stylesheet" href="{{ 'section-departments-hub-flex.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'section-departments-hub-flex.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  #departments-hub-{{ section.id }} {
    --cols-m: 1;
    --cols-d: {{ section.settings.columns | default: 3 }};
  }
  #departments-hub-{{ section.id }} .title-wrap {
    margin-bottom: 1.25rem;
  }
  #departments-hub-{{ section.id }} .title-wrap .title {
    margin: 0;
  }
  #departments-hub-{{ section.id }} .title-wrap p {
    margin: .25rem 0 0;
    color: rgba(var(--color-foreground), .75);
  }
{%- endstyle -%}

<section id="departments-hub-{{ section.id }}" class="section">
  <div class="page-width">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="title-wrap">
        {% if section.settings.heading != blank %}
          <h2 class="title inline-richtext">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ul class="dept-hub-grid">
        {% for block in section.blocks %}
          {% assign parent_coll = block.settings.parent_collection %}
          {% assign title = block.settings.title %}
          {% if title == blank and parent_coll %}
            {% assign title = parent_coll.title %}
          {% endif %}

          {% assign parent_url = block.settings.parent_url %}
          {% if parent_coll %}
            {% assign parent_url = parent_coll.url %}
          {% endif %}

          {% assign limit_n = block.settings.limit | default: 6 %}
          {% assign child_source = block.settings.child_source | default: 'menu' %}

          <li class="dept-card" {{ block.shopify_attributes }}>
            <div class="dept-card__inner">
              <div class="dept-card__header">
                <div class="dept-card__title-wrap">
                  {% if block.settings.icon != blank %}
                    <div class="dept-card__icon">
                      <img src="{{ block.settings.icon | image_url: width: 96 }}" alt="" loading="lazy" width="96" height="96">
                    </div>
                  {% endif %}
                  <h3 class="dept-card__title">
                    {% if parent_url != blank %}
                      <a class="dept-card__title-link" href="{{ parent_url | escape }}">{{ title | default: 'Department' | escape }}</a>
                    {% else %}
                      {{ title | default: 'Department' | escape }}
                    {% endif %}
                  </h3>
                </div>

                {% if parent_url != blank and block.settings.show_view_all %}
                  <a href="{{ parent_url | escape }}" class="dept-card__view">{{ block.settings.view_all_label | default: 'Shop all' | escape }}</a>
                {% endif %}
              </div>

              <div class="dept-card__body">
                {% assign rendered = false %}

                {%- if child_source == 'menu' and block.settings.menu != blank -%}
                  {% assign menu = linklists[block.settings.menu] %}
                  {% if menu and menu.links.size > 0 %}
                    <ul class="dept-list">
                      {% for l in menu.links limit: limit_n %}
                        <li class="dept-list__item">
                          <a href="{{ l.url | escape }}" class="dept-pill">{{ l.title | escape }}</a>
                        </li>
                      {% endfor %}
                    </ul>
                    {% assign rendered = true %}
                  {% endif %}
                {%- endif -%}

                {%- if rendered == false and child_source == 'metafield' and parent_coll and parent_coll.metafields.navigation.subcollections and parent_coll.metafields.navigation.subcollections.value -%}
                  {% assign subs = parent_coll.metafields.navigation.subcollections.value %}
                  {% if subs.size > 0 %}
                    <ul class="dept-grid-mini">
                      {% for c in subs limit: limit_n %}
                        {% assign c_alt = c.title | escape %}
                        <li>
                          <a class="mini-card" href="{{ c.url | escape }}">
                            <span class="mini-card__media">
                              {% if c.image %}
                                <img
                                  src="{{ c.image | image_url: width: 360 }}"
                                  loading="lazy"
                                  alt="{{ c_alt }}"
                                  width="360"
                                  height="{{ 360 | divided_by: c.image.aspect_ratio | round }}"
                                >
                              {% else %}
                                <span class="mini-card__ph">•</span>
                              {% endif %}
                            </span>
                            <span class="mini-card__info">
                              <span class="mini-card__title">{{ c.title | escape }}</span>
                              {% if block.settings.show_counts %}
                                <span class="mini-card__sub">
                                  {{ c.all_products_count }} {{ c.all_products_count | pluralize: 'product', 'products' }}
                                </span>
                              {% endif %}
                            </span>
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                    {% assign rendered = true %}
                  {% endif %}
                {%- endif -%}

                {%- if rendered == false and child_source == 'manual' and block.settings.children_collections and block.settings.children_collections.size > 0 -%}
                  {% assign subs = block.settings.children_collections %}
                  <ul class="dept-grid-mini">
                    {% for c in subs limit: limit_n %}
                      {% assign c_alt = c.title | escape %}
                      <li>
                        <a class="mini-card" href="{{ c.url | escape }}">
                          <span class="mini-card__media">
                            {% if c.image %}
                              <img
                                src="{{ c.image | image_url: width: 360 }}"
                                loading="lazy"
                                alt="{{ c_alt }}"
                                width="360"
                                height="{{ 360 | divided_by: c.image.aspect_ratio | round }}"
                              >
                            {% else %}
                              <span class="mini-card__ph">•</span>
                            {% endif %}
                          </span>
                          <span class="mini-card__info">
                            <span class="mini-card__title">{{ c.title | escape }}</span>
                            {% if block.settings.show_counts %}
                              <span class="mini-card__sub">
                                {{ c.all_products_count }} {{ c.all_products_count | pluralize: 'product', 'products' }}
                              </span>
                            {% endif %}
                          </span>
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                  {% assign rendered = true %}
                {%- endif -%}

                {% if rendered == false %}
                  <p class="dept-empty">Add a menu, or pick a parent collection with metafield <code>navigation.subcollections</code>, or choose collections manually.</p>
                {% endif %}
              </div>
            </div>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p style="color:rgba(var(--color-foreground),.75)">Add blocks for Gaming, Sports & Wellness, Holidays, Suno Music, Downloads, etc.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Departments hub (flex)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by department" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 }
  ],
  "blocks": [
    {
      "type": "department",
      "name": "Department",
      "settings": [
        { "type": "text", "id": "title", "label": "Title (optional override)" },
        { "type": "collection", "id": "parent_collection", "label": "Parent collection (optional)" },
        { "type": "url", "id": "parent_url", "label": "Parent link (page, external, etc.)" },
        { "type": "image_picker", "id": "icon", "label": "Icon (optional)" },

        {
          "type": "select",
          "id": "child_source",
          "label": "Children source",
          "default": "menu",
          "options": [
            { "value": "menu", "label": "Menu (best for mixed links)" },
            { "value": "metafield", "label": "Collection metafield (navigation.subcollections)" },
            { "value": "manual", "label": "Manual: pick collections" }
          ]
        },

        { "type": "link_list", "id": "menu", "label": "Menu (when source = Menu)" },
        { "type": "collection_list", "id": "children_collections", "label": "Collections (when source = Manual)" },

        { "type": "range", "id": "limit", "label": "Max items to show", "min": 1, "max": 12, "step": 1, "default": 6 },
        { "type": "checkbox", "id": "show_counts", "label": "Show product counts (collections only)", "default": false },
        { "type": "checkbox", "id": "show_view_all", "label": "Show “Shop all” link", "default": true },
        { "type": "text", "id": "view_all_label", "label": "“Shop all” label", "default": "Shop all" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Departments hub (flex)",
      "blocks": [
        { "type": "department", "settings": { "title": "Gaming" } },
        { "type": "department", "settings": { "title": "Sports & Wellness" } },
        { "type": "department", "settings": { "title": "Holidays" } }
      ]
    }
  ]
}
{% endschema %}
