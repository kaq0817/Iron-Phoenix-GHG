{% comment %}
  Main Blog section
  - Styles now correctly externalized to assets/section-main-blog.css
  - Uses theme's global CSS variables for colors
{% endcomment %}

{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }} {# Correctly linking the existing external CSS file #}

{%- style -%}
  /* Define CSS variables for padding and colors dynamically from section settings.
     These variables are used by assets/section-main-blog.css */
  .main-blog.section-{{ section.id }}-padding {
    --main-blog-padding-top-mobile: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --main-blog-padding-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    --main-blog-padding-top-desktop: {{ section.settings.padding_top }}px;
    --main-blog-padding-bottom-desktop: {{ section.settings.padding_bottom }}px;
    --color-wellness-background: rgb(var(--color-background)); /* Base background from global scheme */
    --color-wellness-text: rgb(var(--color-foreground)); /* Base foreground from global scheme */
  }
{%- endstyle -%}

{%- paginate blog.articles by 6 -%}
  <div class="main-blog page-width section-{{ section.id }}-padding" itemscope itemtype="http://schema.org/Blog">
    <h1 class="title--primary{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}" style="font-family: var(--font-heading-family);">
      {{ blog.title | escape }}
    </h1>

    {%- comment -%} Grid auto-fit based on layout {%- endcomment -%}
    <div class="blog-articles {% if section.settings.layout == 'collage' %}blog-articles--collage{% endif %}"
         style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));">
      {%- for article in blog.articles -%}
        {%- assign excerpt_fallback = article.excerpt | default: article.content -%}
        <article class="blog-articles__article article{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                 {% if settings.animations_reveal_on_scroll %}data-cascade style="--animation-order: {{ forloop.index }};"{% endif %}
                 itemscope itemtype="http://schema.org/BlogPosting">

          {% if section.settings.show_image and article.image %}
            <a class="article-card__image" href="{{ article.url }}" aria-label="{{ article.title | escape }}">
              {{
                article.image
                | image_url: width: 800
                | image_tag:
                  widths: '400,600,800',
                  sizes: '(max-width: 749px) 100vw, 400px',
                  loading: 'lazy',
                  decoding: 'async',
                  alt: article.title | escape,
                  width: article.image.width,
                  height: article.image.width | divided_by: article.image.aspect_ratio | round
              }}
            </a>
          {% endif %}

          <h2 class="article-card__title h3" itemprop="headline">
            <a href="{{ article.url }}">{{ article.title | escape }}</a>
          </h2>

          <div class="article-card__meta">
            {% if section.settings.show_date %}
              <time itemprop="datePublished" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                {{ article.published_at | date: '%B %d, %Y' }}
              </time>
            {% endif %}
            {% if section.settings.show_author %}
              <span aria-hidden="true">•</span>
              <span itemprop="author">{{ article.author | escape }}</span>
            {% endif %}
          </div>

          {%- comment -%}
            SECURITY: Never render article.content raw in index views.
            Use sanitized, escaped excerpt text only.
          {%- endcomment -%}
          <p class="article-card__excerpt" itemprop="description">
            {{ excerpt_fallback | strip_html | truncate: 160 | escape }}
          </p>

          {#-- Structured data helpers --#}
          <meta itemprop="headline" content="{{ article.title | escape }}">
          <meta itemprop="datePublished" content="{{ article.published_at | date: '%Y-%m-%d' }}">
          <meta itemprop="author" content="{{ article.author | escape }}">
        </article>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Main Blog",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "grid", "label": "t:sections.main-blog.settings.layout.options__1.label" },
        { "value": "collage", "label": "t:sections.main-blog.settings.layout.options__2.label" }
      ],
      "default": "collage",
      "label": "t:sections.main-blog.settings.layout.label"
    },
    { "type": "checkbox", "id": "show_image", "default": true, "label": "t:sections.main-blog.settings.show_image.label" },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        { "value": "adapt", "label": "t:sections.main-blog.settings.image_height.options__1.label" },
        { "value": "small", "label": "t:sections.main-blog.settings.image_height.options__2.label" },
        { "value": "medium", "label": "t:sections.main-blog.settings.image_height.options__3.label" },
        { "value": "large", "label": "t:sections.main-blog.settings.image_height.options__4.label" }
      ],
      "default": "medium",
      "label": "t:sections.main-blog.settings.image_height.label"
    },
    { "type": "checkbox", "id": "show_date", "default": true, "label": "t:sections.main-blog.settings.show_date.label" },
    { "type": "checkbox", "id": "show_author", "default": false, "label": "t:sections.main-blog.settings.show_author.label" },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 36 }
  ]
}
{% endschema %}