{%- liquid
  assign heading_text = section.settings.headline | default: shop.name
  assign sub_text     = section.settings.subheadline
  assign cta_link     = section.settings.cta_link | default: routes.all_products_collection_url
-%}

{{ 'section-hero-custom.css' | asset_url | stylesheet_tag }}

<style>
  .hero-custom {
    --hero-headline-color: {{ section.settings.headline_color }};
    --hero-subheadline-color: {{ section.settings.subheadline_color }};
    --hero-button-bg-color: {{ section.settings.cta_bg_color }};
    --hero-button-text-color: {{ section.settings.cta_text_color }};
    
    position: relative;
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.content_align }};
    min-height: {{ section.settings.min_height }}px;
    overflow: hidden;
    background-color: #050b12;
    color: #ffffff;
  }

  .hero-custom__background {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-custom__background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-custom__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 60px 24px;
    display: flex;
    flex-direction: column;
    align-items: {% if section.settings.content_align == 'center' %}center{% else %}flex-start{% endif %};
    text-align: {% if section.settings.content_align == 'center' %}center{% else %}left{% endif %};
  }

  .hero-custom__headline {
    color: var(--hero-headline-color);
    font-size: {{ section.settings.headline_size }}px;
    font-weight: 900;
    line-height: 0.95;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }

  .hero-custom__subheadline {
    color: var(--hero-subheadline-color);
    font-size: {{ section.settings.subheadline_size }}px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 2.5rem;
  }

  .hero-custom__button {
    background-color: var(--hero-button-bg-color);
    color: var(--hero-button-text-color);
    padding: 0.85rem 1.8rem;
    border-radius: 3px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }
</style>

<section class="hero-custom">
  {%- if section.settings.background_image != blank -%}
    <div class="hero-custom__background">
      {%- comment -%}Adding explicit width/height to satisfy Theme Check {%- endcomment -%}
      {{ section.settings.background_image | image_url: width: 2000 | image_tag: 
        loading: 'eager', 
        width: section.settings.background_image.width,
        height: section.settings.background_image.height,
        alt: section.settings.background_image.alt | escape 
      }}
    </div>
  {%- endif -%}

  <div class="hero-custom__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="hero-custom__eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}

    {%- if heading_text != blank -%}
      <h2 class="hero-custom__headline">{{ heading_text | escape }}</h2>
    {%- endif -%}

    {%- if sub_text != blank -%}
      <p class="hero-custom__subheadline">{{ sub_text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <a href="{{ cta_link }}" class="hero-custom__button">
        {{ section.settings.cta_label | escape }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero Custom",
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "header", "content": "Text content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "EQUIP YOUR NEXT" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "ADVENTURE" },
    { "type": "text", "id": "subheadline", "label": "Subheadline", "default": "APPAREL • ACCESSORIES • LIFESTYLE" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "headline_color", "label": "Headline color", "default": "#ffffff" },
    { "type": "color", "id": "subheadline_color", "label": "Subheadline color", "default": "#ffffff" },
    { "type": "header", "content": "Sizes" },
    {
      "type": "range",
      "id": "headline_size",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Headline font size",
      "default": 80
    },
    {
      "type": "range",
      "id": "subheadline_size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Subheadline font size",
      "default": 14
    },
    { "type": "header", "content": "CTA Button" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "color", "id": "cta_bg_color", "label": "Button background color", "default": "#1a3683" },
    { "type": "color", "id": "cta_text_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "min_height",
      "min": 200,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Minimum height",
      "default": 600
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "flex-start"
    }
  ],
  "presets": [
    {
      "name": "Hero Custom"
    }
  ]
}
{% endschema %}