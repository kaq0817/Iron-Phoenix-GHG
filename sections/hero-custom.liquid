{%- liquid
  assign heading_text = section.settings.headline | default: shop.name
  assign sub_text     = section.settings.subheadline
  assign cta_link     = section.settings.cta_link | default: routes.all_products_collection_url
-%}

{{ 'section-hero-custom.css' | asset_url | stylesheet_tag }}

<style>
  .hero-custom {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.content_align }};
    min-height: {{ section.settings.min_height }}px;
    overflow: hidden;
    background-color: #050b12; /* Brand solid navy [cite: 30, 52] */
  }

  .hero-custom__background {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .hero-custom__background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-custom__nav {
    display: flex;
    gap: 2.5rem;
    justify-content: center;
    margin-bottom: 2.5rem;
    z-index: 3;
    position: relative;
  }
  .hero-custom__nav-link {
    color: {{ section.settings.nav_color | default: '#ffffff' }};
    font-size: {{ section.settings.nav_size | default: 18 }}px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s;
    position: relative;
  }
  .hero-custom__nav-link:hover,
  .hero-custom__nav-link:focus {
    color: {{ section.settings.nav_hover_color | default: '#ffb300' }};
  }

  .hero-custom__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 60px 24px;
    display: flex;
    flex-direction: column;
    align-items: {% if section.settings.content_align == 'center' %}center{% else %}flex-start{% endif %};
    text-align: {% if section.settings.content_align == 'center' %}center{% else %}left{% endif %};
  }

  /* FORCED ROYAL BLUE HEADLINE */
  .hero-custom__headline {
    color: {{ section.settings.headline_color }} !important;
    font-size: {{ section.settings.headline_size }}px;
    font-weight: 900;
    line-height: 0.95;
    text-transform: capitalize;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .hero-custom__subheadline {
    /* Forces the color from your theme editor picker [cite: 18] */
    color: {{ section.settings.subheadline_color | default: '#4169e1' }} !important;
    
    /* Ensures the text is fully opaque and not 'greyed out' */
    opacity: 1 !important;
    
    /* Matches your requested 'capitalize' style [cite: 19] */
    text-transform: capitalize;
    
    /* Keeps the premium spacing for the 'Apparel • Accessories' look [cite: 19] */
    letter-spacing: 0.15em;
    font-weight: 600;
    font-size: {{ section.settings.subheadline_size }}px;
  }
</style>

<section class="hero-custom">
  {%- if section.settings.background_image != blank -%}
    <div class="hero-custom__background">
      {{ section.settings.background_image | image_url: width: 2000 | image_tag: 
        loading: 'eager', 
        width: section.settings.background_image.width,
        height: section.settings.background_image.height,
        alt: section.settings.background_image.alt | escape 
      }}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <nav class="hero-custom__nav" aria-label="Hero collections navigation">
      {%- for block in section.blocks -%}
        <a class="hero-custom__nav-link" href="{{ block.settings.collection | default: '#' }}" {{ block.shopify_attributes }}>
          {{ block.settings.label | escape }}
        </a>
      {%- endfor -%}
    </nav>
  {%- endif -%}

  <div class="hero-custom__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="hero-custom__eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}

    {%- if heading_text != blank -%}
      <h2 class="hero-custom__headline">{{ heading_text | escape }}</h2>
    {%- endif -%}

    {%- if sub_text != blank -%}
      <p class="hero-custom__subheadline">{{ sub_text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <a href="{{ cta_link }}" class="hero-custom__button">
        {{ section.settings.cta_label | escape }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero Custom",
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "header", "content": "Navigation (Collections)" },
    { "type": "color", "id": "nav_color", "label": "Navigation link color", "default": "#ffffff" },
    { "type": "color", "id": "nav_hover_color", "label": "Navigation link hover color", "default": "#ffb300" },
    { "type": "range", "id": "nav_size", "min": 12, "max": 32, "step": 1, "unit": "px", "label": "Navigation font size", "default": 18 },
    { "type": "header", "content": "Text content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Equip Your Next" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Adventure" },
    { "type": "text", "id": "subheadline", "label": "Subheadline", "default": "Apparel • Accessories • Lifestyle" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "headline_color", "label": "Headline & Eyebrow Color", "default": "#4169e1" },
    { "type": "color", "id": "subheadline_color", "label": "Subheadline Color", "default": "#4169e1" },
    { "type": "header", "content": "Sizes" },
    { "type": "range", "id": "headline_size", "min": 20, "max": 120, "step": 2, "unit": "px", "label": "Headline font size", "default": 80 },
    { "type": "range", "id": "subheadline_size", "min": 10, "max": 40, "step": 1, "unit": "px", "label": "Subheadline font size", "default": 14 },
    { "type": "header", "content": "CTA Button" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "color", "id": "cta_bg_color", "label": "Button background color", "default": "#1a3683" },
    { "type": "color", "id": "cta_text_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "min_height", "min": 200, "max": 1000, "step": 20, "unit": "px", "label": "Minimum height", "default": 600 },
    { "type": "select", "id": "content_align", "label": "Content alignment", "options": [{ "value": "flex-start", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "flex-start" }
  ],
  "blocks": [
    {
      "type": "collection_link",
      "name": "Collection Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Link label", "default": "Collection" },
        { "type": "url", "id": "collection", "label": "Collection link" }
      ]
    }
  ],
  "presets": [{ "name": "Hero Custom", "blocks": [ { "type": "collection_link" } ] }]
}
{% endschema %}