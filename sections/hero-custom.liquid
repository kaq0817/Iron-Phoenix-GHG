{%- comment -%}
/sections/hero-custom.liquid
Hero Custom Section
- Styles externalized to assets/section-hero-custom.css
- Uses optimized-image snippet for background image
- Uses theme's global CSS variables for colors
{%- endcomment -%}

{{ 'section-hero-custom.css' | asset_url | stylesheet_tag: preload: true, onload: "this.media='all'" }}
<noscript>{{ 'section-hero-custom.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign heading_text = section.settings.headline | default: section.settings.title | default: shop.name
  assign sub_text     = section.settings.subheadline | default: section.settings.subtitle
  assign cta_link     = section.settings.cta_link | default: routes.all_products_collection_url
  assign has_bg       = section.settings.background_image
  assign has_heading  = heading_text != blank
-%}

<section
  class="hero-custom color-{{ section.settings.color_scheme }}"
  role="region"
  {% if has_heading %}aria-labelledby="HeroHeading-{{ section.id }}"{% else %}aria-label="{{ shop.name | escape }}"{% endif %}
  {% if has_bg %}
    style="--hero-bg: url({{ section.settings.background_image | image_url: width: 1920, format: 'webp' }});"
  {% endif %}
>
  {% if section.settings.logo %}
    <img
      src="{{ section.settings.logo | image_url: width: 400, format: 'webp' }}"
      alt="{{ heading_text | escape }}"
      width="200"
      height="200"
      loading="lazy"
      class="hero-logo"
    >
  {% endif %}

  {% if has_heading %}
    <h1 class="hero-headline neon-glow" id="HeroHeading-{{ section.id }}">
      {{ heading_text | escape }}
    </h1>
  {% endif %}

  {% if sub_text %}
    <p class="hero-subheadline" id="HeroSub-{{ section.id }}">
      {{ sub_text | escape }}
    </p>
  {% endif %}

  {% if section.settings.cta_label and cta_link %}
    <a href="{{ cta_link | escape }}" class="button--neon">
      {{ section.settings.cta_label | escape }}
    </a>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hero Custom",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Hero logo" },
    { "type": "image_picker", "id": "background_image", "label": "Background image (optional)" },

    { "type": "text", "id": "headline", "label": "Headline", "default": "Forged Phoenix" },
    { "type": "text", "id": "subheadline", "label": "Subheadline", "default": "Strength. Resilience. Rebirth." },

    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop now" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },

    { "type": "text", "id": "title", "label": "Fallback title (legacy)", "default": "Welcome to Iron Phoenix GHG" },
    { "type": "text", "id": "subtitle", "label": "Fallback subtitle (legacy)", "default": "Gaming gear designed with wellness in mind" }
  ],
  "presets": [
    { "name": "Hero Custom" }
  ]
}
{% endschema %}