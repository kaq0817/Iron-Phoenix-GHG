{% comment %}
  Iron Phoenix GHG — Complete Compliance Footer (Final)
  - Layout: Grid-based (No boxes)
  - Identity: WY LLC + NY Operations
  - Compliance: Clickable Tel, Horizontal Pay Icons, Full Social Set
{% endcomment %}


<footer class="ipx-footer" role="contentinfo">
  <style>
    .ipx-footer {
      background: #0f1c2e;
      color: #f4f6fb;
      border-top: 1px solid rgba(201, 168, 76, 0.35);
      padding: 72px 32px 48px;
      font-family: 'Inter', sans-serif;
    }
    .ipx-wrap {
  width: min(1440px, calc(100vw - 48px));
  margin: 0 auto;
}



    .ipx-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(220px, 1fr));
  gap: clamp(24px, 2.4vw, 36px);
  align-items: start;
  margin-bottom: 48px;
}

.ipx-col {
  min-width: 0;
}

.ipx-col p {
  margin: 0 0 16px;
  line-height: 1.65;
  color: #f4f6fb !important;
}

.ipx-col h3 {
  color: #d9c49a;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 22px;
  font-size: 1.35rem;
  border-bottom: 1px solid var(--color-border-subtle);
  padding-bottom: 12px;
}

    .ipx-link { color: #f4f6fb; text-decoration: none; transition: 0.3s; }
    .ipx-link:hover { color: #b8d4da; }

    .ipx-footer p,
    .ipx-footer li,
    .ipx-footer strong,
    .ipx-footer em,
    .ipx-footer span,
    .ipx-footer a {
      color: #f4f6fb !important;
    }

    .ipx-footer a:hover,
    .ipx-footer .ipx-link:hover,
    .ipx-footer .ipx-policies a:hover {
      color: #b8d4da !important;
    }
    
    /* Socials */
    .ipx-social { display: flex; flex-wrap: wrap; gap: 15px; margin-top: 15px; }
    .ipx-sicon { width: 20px; height: 20px; fill: var(--color-icon-default); transition: 0.3s; }
    .ipx-slink:hover .ipx-sicon { fill: var(--color-accent); transform: scale(1.1); }

    /* Payments */
    .ipx-pay { display: flex; flex-wrap: wrap; gap: 10px; margin: 15px 0; }
    .ipx-pay svg { width: 38px; height: 24px; }

    /* Legal Anchor */
    .ipx-anchor {
      text-align: center;
      margin-top: 40px;
      padding-top: 30px;
      border-top: 1px solid var(--color-border-subtle-dark);
      font-size: 12px;
      color: var(--color-text-faded);
    }
    .ipx-anchor strong { color: var(--color-text-highlight); }

    /* Policy List */
    .ipx-policies {
      list-style: none;
      padding: 0;
      display: flex;
      justify-content: center;
      gap: 20px;
      margin: 20px 0;
      flex-wrap: wrap;
    }
.ipx-policies a {
  color: #f4f6fb;
  text-decoration: none;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.2px;
}
    .ipx-policies a:hover { color: #b8d4da; }

   .ipx-bizbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 12px 18px;
  background: transparent;
  border: 1px solid var(--color-accent);
  color: #f4f6fb;
  border-radius: 999px;
  cursor: pointer;
  font-size: 15px;
  font-weight: 600;
  line-height: 1;
  transition: 0.2s ease;
  box-shadow: none;
}
.ipx-bizbtn:hover {
  background: rgba(184, 212, 218, 0.14);
  color: #b8d4da;
}

.ipx-gate[hidden] { display: none !important; }
.ipx-gate {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  padding: 20px;
}
.ipx-gate-card {
  max-width: 480px;
  width: 100%;
  background: var(--color-card-bg, #ffffff);
  border: 1px solid var(--color-border-subtle);
  border-radius: 18px;
  padding: 24px;
}
.ipx-gate-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 18px;
}
.ipx-gate-cancel,
.ipx-gate-confirm {
  text-decoration: none;
  border-radius: 999px;
  padding: 10px 14px;
  font-size: 13px;
  cursor: pointer;
}
.ipx-gate-cancel {
  background: transparent;
  border: 1px solid var(--color-border-subtle);
  color: var(--color-main-text, #1F1F1F);
}
.ipx-gate-confirm {
  background: var(--color-accent);
  border: 1px solid var(--color-accent);
  color: #111;
  font-weight: 600;
}

@media (max-width: 1024px) {
  .ipx-wrap {
    width: min(100%, calc(100vw - 32px));
  }

  .ipx-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }
}

@media (max-width: 640px) {
  .ipx-footer {
    padding: 44px 16px 28px;
  }

  .ipx-grid {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .ipx-col p {
    font-size: 15px;
  }
}
  .ipx-anchor {
  text-align: center;
  margin-top: 48px;
  padding-top: 32px;
  border-top: 1px solid var(--color-border-subtle-dark);
  font-size: 14px;
  color: var(--color-text-faded);
  max-width: 1100px;
  margin-left: auto;
  margin-right: auto;
}

.ipx-policies {
  list-style: none;
  padding: 0;
  display: flex;
  justify-content: center;
  gap: 28px;
  margin: 8px auto 28px;
  flex-wrap: wrap;
  max-width: 1100px;
}


  </style>

