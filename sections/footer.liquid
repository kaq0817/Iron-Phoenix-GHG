  <script>
    document.querySelectorAll('.ipx-em').forEach(function(el){
      var email = el.dataset.u + '@' + el.dataset.d;
      var subject = el.dataset.subject ? '?subject=' + el.dataset.subject : '';
      if (el.tagName === 'A') el.href = 'mailto:' + email + subject;
      if (!el.textContent.trim()) el.textContent = email;
    });
  </script>
