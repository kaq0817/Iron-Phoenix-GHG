{% comment %}
  Iron Phoenix GHG — Complete Compliance Footer (Final)
  - Layout: Grid-based (No boxes)
  - Identity: Go Hard Gaming Discord LLC (WY + NY)
  - Compliance: Clickable Tel, Horizontal Pay Icons, Full Social Set
{% endcomment %}

<footer class="ipx-footer" role="contentinfo">
  <style>
    .ipx-footer {
      background: #0B1E36 !important; /* Solid, commanding Deep Navy — zero transparency */
      background-image: none !important;
      color: #FFFFFF !important;
      border-top: 4px solid #A6192E;  /* Solid Flag Red border boundary track */
      padding: 72px 32px 48px;
      font-family: 'Inter', sans-serif;
    }

    .ipx-footer,
    .ipx-footer .ipx-wrap,
    .ipx-footer .ipx-grid,
    .ipx-footer .ipx-col,
    .ipx-footer p,
    .ipx-footer li,
    .ipx-footer span,
    .ipx-footer strong,
    .ipx-footer em,
    .ipx-footer a {
      color: #FFFFFF !important; /* Force high-contrast pure white legibility on text blocks */
    }

    .ipx-wrap {
      width: min(1440px, calc(100vw - 48px));
      margin: 0 auto;
    }

    .ipx-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(220px, 1fr));
      gap: clamp(24px, 2.4vw, 36px);
      align-items: start;
      margin-bottom: 48px;
    }

    .ipx-col {
      min-width: 0;
    }

    .ipx-col p {
      margin: 0 0 16px;
      line-height: 1.65;
      color: #FFFFFF !important;
    }

    .ipx-col h3 {
      color: #FFFFFF;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 22px;
      font-size: 1.4rem;
      font-weight: 800;
      border-bottom: 2px solid #A6192E; /* Crisp red line divider */
      padding-bottom: 12px;
    }

    .ipx-link { 
      color: #FFFFFF !important; 
      text-decoration: none; 
      transition: color 0.15s ease; 
    }
    .ipx-link:hover { 
      color: #A6192E !important; /* Bold Red flash on hover items */
      text-decoration: underline !important;
    }

    .ipx-footer a:hover,
    .ipx-footer .ipx-link:hover,
    .ipx-footer .ipx-policies a:hover {
      color: #A6192E !important;
    }
    
    /* Social Panel Link Adjustments */
    .ipx-social { 
      display: flex; 
      flex-wrap: wrap; 
      gap: 16px; 
      margin-top: 15px; 
    }
    .ipx-sicon { 
      width: 24px; 
      height: 24px; 
      fill: #FFFFFF !important; /* Opaque white icons inside footer */
      transition: transform 0.15s ease, fill 0.15s ease; 
    }
    .ipx-slink:hover .ipx-sicon { 
      fill: #A6192E !important; /* Pop Red on hover states */
      transform: scale(1.15); 
    }

    /* Payments Icon Elements Track */
    .ipx-pay { 
      display: flex; 
      flex-wrap: wrap; 
      gap: 10px; 
      margin: 15px 0; 
    }
    .ipx-pay svg { 
      width: 38px; 
      height: 24px; 
    }

    /* Legal Anchor Base Layer */
    .ipx-anchor {
      text-align: center;
      margin-top: 40px;
      padding-top: 30px;
      border-top: 2px solid #A6192E; /* Red border track alignment block */
      font-size: 13px;
      color: #FFFFFF !important;
    }
    .ipx-anchor strong { 
      color: #FFFFFF !important; 
      font-weight: 800;
    }

    /* Policy List Layout */
    .ipx-policies {
      list-style: none;
      padding: 0;
      display: flex;
      justify-content: center;
      gap: 24px;
      margin: 20px 0;
      flex-wrap: wrap;
    }
    .ipx-policies a {
      color: #FFFFFF;
      text-decoration: none;
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .ipx-policies a:hover { 
      color: #A6192E !important; 
      text-decoration: underline !important;
    }

    /* Supplier Window Button */
    .ipx-bizbtn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 12px 20px;
      background: transparent;
      border: 2px solid #FFFFFF;
      color: #FFFFFF;
      border-radius: 4px; /* Matches clean block profile */
      cursor: pointer;
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      line-height: 1;
      transition: all 0.15s ease;
      box-shadow: none;
    }
    .ipx-bizbtn:hover {
      background: #FFFFFF !important;
      color: #0B1E36 !important;
    }

    .ipx-gate[hidden] { display: none !important; }
    .ipx-gate {
      position: fixed;
      inset: 0;
      background: #0B1E36 !important; /* Solid Navy modal wrap instead of faded black blend */
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: 20px;
    }
    .ipx-gate-card {
      max-width: 480px;
      width: 100%;
      background: #FFFFFF !important; /* Solid pure white layout card */
      border: 3px solid #0B1E36;
      border-radius: 4px;
      padding: 28px;
    }
    .ipx-gate-card h4 {
      font-size: 1.8rem;
      font-weight: 800;
      color: #0B1E36 !important;
      margin-bottom: 12px;
      text-transform: uppercase;
    }
    .ipx-gate-card p {
      color: #1A1A1A !important;
      font-size: 1.4rem;
      margin-bottom: 12px;
      line-height: 1.5;
    }
    .ipx-gate-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 20px;
    }
    .ipx-gate-cancel,
    .ipx-gate-confirm {
      text-decoration: none;
      border-radius: 4px;
      padding: 12px 18px;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      cursor: pointer;
    }
    .ipx-gate-cancel {
      background: transparent;
      border: 2px solid #0B1E36;
      color: #0B1E36 !important;
    }
    .ipx-gate-cancel:hover {
      background: #F7F7F5 !important;
    }
    .ipx-gate-confirm {
      background: #A6192E !important;
      border: 2px solid #A6192E;
      color: #FFFFFF !important;
    }
    .ipx-gate-confirm:hover {
      background: #BD1E35 !important;
    }

    @media (max-width: 1024px) {
      .ipx-wrap {
        width: min(100%, calc(100vw - 32px));
      }
      .ipx-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 28px;
      }
    }

    @media (max-width: 640px) {
      .ipx-footer {
        padding: 44px 16px 28px;
      }
      .ipx-grid {
        grid-template-columns: 1fr;
        gap: 28px;
      }
    }
  </style>

