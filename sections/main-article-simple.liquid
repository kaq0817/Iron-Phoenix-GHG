{% comment %}
  Go Hard Gaming Discord LLC — Simple Article Template
  - Clean layout, no locking
  - Adds width/height to <img> to satisfy theme-check (ImgWidthAndHeight)
  - Includes srcset/sizes for responsive performance
{% endcomment %}
{%- if article -%}
<section id="ArticleSimple-{{ section.id }}" class="article-simple color-{{ section.settings.color_scheme }}">
  <div class="page-width article-simple__inner">
    {%- if section.settings.show_cover_image and article.image -%}
      {%- assign cover_img = article.image -%}
      {%- assign cover_alt = cover_img.alt | default: article.title | escape -%}
      {%- assign src_widths = '400,600,900,1200' | split: ',' -%}
      {%- assign max_width = 1200 -%}
      {%- assign intrinsic_w = cover_img.width -%}
      {%- assign intrinsic_h = cover_img.width | divided_by: cover_img.aspect_ratio | round -%}
      <div class="article-simple__media">
        <img
          src="{{ cover_img | image_url: width: max_width }}"
          srcset="
            {%- for w in src_widths -%}
              {{ cover_img | image_url: width: w }} {{ w }}w{%- unless forloop.last -%}, {% endunless -%}
            {%- endfor -%}
          "
          sizes="(max-width: 749px) 100vw, 1000px"
          alt="{{ cover_alt }}"
          loading="lazy"
          decoding="async"
          class="article-simple__image"
          width="{{ intrinsic_w }}"
          height="{{ intrinsic_h }}"
        />
      </div>
    {%- endif -%}
    <header class="article-simple__header">
      <h1 class="article-simple__title">{{ article.title | escape }}</h1>
      {%- if section.settings.show_meta -%}
        <p class="article-simple__meta">
          {{ article.published_at | date: "%B %d, %Y" }}
          {%- if article.author -%}
            &nbsp;•&nbsp;{{ article.author | escape }}
          {%- endif -%}
        </p>
      {%- endif -%}
      {%- if section.settings.show_excerpt and article.excerpt != blank -%}
        <div class="article-simple__excerpt">{{ article.excerpt }}</div>
      {%- endif -%}
    </header>
    <div class="article-simple__body rte">
      {%- comment -%} Video embed from metafield {%- endcomment -%}
      {%- assign video_url = article.metafields.custom.video_url.value | default: '' -%}
      
      {%- if video_url != blank -%}
        {%- assign v = video_url | strip -%}
        {%- assign video_kind = '' -%}
        {%- assign embed_src = '' -%}
        
        {%- if v contains '.mp4' or v contains '.webm' or v contains '.mov' -%}
          {%- assign video_kind = 'file' -%}
          {%- assign embed_src = v -%}
        {%- elsif v contains 'youtu.be/' -%}
          {%- assign video_kind = 'youtube' -%}
          {%- assign vid = v | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first -%}
          {%- assign embed_src = 'https://www.youtube.com/embed/' | append: vid -%}
        {%- elsif v contains 'youtube.com/watch' and v contains 'v=' -%}
          {%- assign video_kind = 'youtube' -%}
          {%- assign q = v | split: 'v=' | last -%}
          {%- assign vid = q | split: '&' | first -%}
          {%- assign embed_src = 'https://www.youtube.com/embed/' | append: vid -%}
        {%- elsif v contains 'youtube.com/shorts/' -%}
          {%- assign video_kind = 'youtube' -%}
          {%- assign vid = v | split: 'youtube.com/shorts/' | last | split: '?' | first | split: '&' | first -%}
          {%- assign embed_src = 'https://www.youtube.com/embed/' | append: vid -%}
        {%- elsif v contains 'vimeo.com/' -%}
          {%- assign video_kind = 'vimeo' -%}
          {%- assign tail = v | split: 'vimeo.com/' | last -%}
          {%- assign vid = tail | split: '?' | first | split: '&' | first -%}
          {%- assign embed_src = 'https://player.vimeo.com/video/' | append: vid -%}
        {%- endif -%}
        
        {%- if embed_src != blank -%}
          <div class="article__video" style="margin: 16px 0 18px;">
            {%- if video_kind == 'file' -%}
              <video
                controls
                playsinline
                preload="metadata"
                style="width:100%;max-width:900px;border-radius:12px;"
              >
                <source src="{{ embed_src | escape }}" type="video/mp4" />
                Your browser does not support the video tag.
              </video>
            {%- else -%}
              <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;max-width:900px;border-radius:12px;">
                <iframe
                  src="{{ embed_src | escape }}"
                  style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
      
      {{ article.content }}
    </div>
  </div>
</section>

<script>
  (function () {
    var body = document.querySelector('#ArticleSimple-{{ section.id }} .article-simple__body');
    if (!body) return;
    body.querySelectorAll('img').forEach(function (img) {
      var src = img.getAttribute('src');
      if (!src || !src.includes('cdn.shopify.com')) return;
      // Add loading=lazy if missing
      if (!img.getAttribute('loading')) img.setAttribute('loading', 'lazy');
      // Rewrite URL to serve max 900px wide via Shopify CDN
      if (!src.match(/_\d+x/) && !src.includes('width=')) {
        img.setAttribute('src', src.replace(/(\.[a-z]{3,4})(\?|$)/i, '_900x$1$2'));
        var srcset = img.getAttribute('srcset');
        if (!srcset) {
          img.setAttribute('srcset',
            src.replace(/(\.[a-z]{3,4})(\?|$)/i, '_450x$1$2') + ' 450w, ' +
            src.replace(/(\.[a-z]{3,4})(\?|$)/i, '_900x$1$2') + ' 900w'
          );
          img.setAttribute('sizes', '(max-width: 749px) 100vw, 900px');
        }
      }
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Simple article",
  "class": "section-article-simple",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "checkbox",
      "id": "show_meta",
      "label": "Show date/author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cover_image",
      "label": "Show cover image (if set)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show article excerpt",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Simple article"
    }
  ]
}
{% endschema %}