{% comment %}
  Horizontal row of product images (thumbs)
  - Styles externalized to assets/section-product-gallery-row.css
  - Uses theme's global CSS variables for colors
{% endcomment %}

{{ 'section-product-gallery-row.css' | asset_url | stylesheet_tag }} {# Link to new external CSS #}

{%- style -%}
  /* Define CSS variables for dynamic margin */
  .gallery-row#gallery-row-{{ section.id }} {
    --gallery-row-margin: 1.5rem 0; /* Original fixed margin value */
    /* If this margin should become configurable via section settings, a new setting
       would need to be added to the schema and referenced here. */
  }
{%- endstyle -%}

<section id="gallery-row-{{ section.id }}" class="gallery-row">
  {% if product and product.media.size > 0 %}
    <div class="row" aria-label="Additional product images">
      {% for m in product.media limit: 12 %}
        {% if m.media_type == 'image' %}
          {% assign w = 320 %}
          {% assign h = w | divided_by: m.aspect_ratio | round %}
          <img
            src="{{ m | image_url: width: w }}"
            alt="{{ m.alt | default: product.title | escape }}"
            loading="lazy"
            width="{{ w }}"
            height="{{ h }}">
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{ "name": "Product gallery row", "settings": [], "presets": [{ "name": "Product gallery row"}] }
{% endschema %}