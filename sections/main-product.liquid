{%- comment -%}
  Iron Phoenix GHG LLC — Main Product Template- Main Product (With FAQ Accordion)
  Upgraded: Solid borders, block swatches, hardcoded shipping trust tab.
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'section-main-product.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'section-main-product.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-price.css' | asset_url | stylesheet_tag }}</noscript>

<script src="{{ 'product-tabs.js' | asset_url }}" defer></script>

{%- assign p = product -%}
{%- assign v = p.selected_or_first_available_variant -%}
{%- assign hero_media = v.featured_media | default: p.featured_media -%}

{%- comment -%} Prepare POD and Inventory Logic {%- endcomment -%}
{%- render 'pod-guard', product: p -%}
{%- render 'inventory-guard', product: p -%}
{%- render 'structured-product', product: p -%}

<style>
  /* --- LAYOUT GRID --- */
  .product-section {
    max-width: 140rem;
    margin: 0 auto;
    padding: 2rem;
    color: #1F1F1F;
  }

  .product-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  @media screen and (min-width: 990px) {
    .product-grid {
      flex-direction: row;
      align-items: flex-start;
      gap: 5rem;
    }
    .product__media-wrapper {
      width: 60%;
    }
    .product__info-wrapper {
      width: 40%;
      position: sticky;
      top: 3rem;
    }
  }

  /* --- MEDIA --- */
  .product__media-main img {
    width: 100%;
    border-radius: 8px;
    object-fit: cover;
  }

  .product__thumbnails {
    display: flex;
    gap: 10px;
    margin-top: 15px;
    flex-wrap: wrap;
  }

  .thumb {
    width: 80px;
    height: 80px;
    border: 2px solid #e5e7eb; /* Solid gray border, no cloudy/invisible borders */
    cursor: pointer;
    border-radius: 4px;
    padding: 0;
    background: #ffffff;
  }

  .thumb.active {
    border-color: #1e4db7; /* Bright Jewel Blue */
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 2px;
  }

  /* --- INFO --- */
  .product__title {
    font-size: 2.8rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: #0f1c2e;
  }
  .product__meta-desc {
    font-size: 1.5rem;
    margin-bottom: 2rem;
    color: #555555;
  }
  .product__price {
    font-size: 2.2rem;
    font-weight: 700;
    margin-bottom: 2rem;
    color: #1F1F1F;
  }

  /* --- SOLID VARIANT SWATCHES --- */
  .product__option {
    margin-bottom: 1.5rem;
  }
  .product__option legend {
    font-weight: 600;
    margin-bottom: 0.8rem;
    display: block;
  }
  .product__swatch input:checked + span {
    background: #1e4db7; /* Bright Jewel Blue background */
    color: #ffffff;
    border-color: #1e4db7;
  }
  .product__swatch input {
    display: none; /* Hide default radio buttons */
  }
  .product__swatch span {
    display: inline-block;
    padding: 10px 18px;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    background: #ffffff;
    color: #1F1F1F;
    font-weight: 500;
    transition: all 0.2s ease;
  }
  .product__swatch input:checked + span {
    background: #0f1c2e;
    color: #ffffff;
    border-color: #0f1c2e;
  }

  /* --- ADD TO CART --- */
  .product__add-to-cart {
    width: 100%;
    margin-top: 1rem;
    padding: 1.6rem;
    font-size: 1.6rem;
    font-weight: 700;
    background: #26A69A;
    color: #1F1F1F;
  }
  .product__add-to-cart:hover {
    background: #1e8772;
  }
  .product__add-to-cart:disabled {
    background: #e5e7eb;
    color: #9ca3af;
    cursor: not-allowed;
  }

  /* --- PRODUCT TABS --- */
  .product-tabs-section {
    max-width: 140rem;
    margin: 4rem auto 0;
    padding: 0 2rem;
  }
  .product-tabs__nav {
    display: flex;
    gap: 0;
    border-bottom: 2px solid #e5e7eb;
    margin-bottom: 0;
  }
  .product-tab-button {
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    padding: 1.2rem 2rem;
    font-size: 1.5rem;
    font-weight: 600;
    color: #6b7280;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .product-tab-button:hover {
    color: #0f1c2e;
  }
  .product-tab-button.is-active {
    color: #0f1c2e;
    border-bottom-color: #26A69A;
  }
  .product-tab-panel {
    padding: 2.5rem 0;
    font-size: 1.5rem;
    line-height: 1.7;
    color: #374151;
  }
  .product-tab-panel.is-hidden {
    display: none;
  }
  .product-tab-panel .rte p + p {
    margin-top: 1em;
  }

  /* --- FAQ inside tab --- */
  .faq-item {
    border-bottom: 1px solid #e5e7eb;
  }
  .faq-question {
    padding: 1.5rem 0;
    cursor: pointer;
    font-weight: 700;
    display: flex;
    justify-content: space-between;
    font-size: 1.5rem;
    color: #0f1c2e;
  }
  .faq-answer {
    display: none;
    padding: 0 0 1.5rem;
    font-size: 1.4rem;
    line-height: 1.6;
    color: #374151;
  }
  .faq-arrow {
    transition: transform 0.2s ease;
    flex-shrink: 0;
    margin-left: 1rem;
  }
  .faq-open .faq-arrow {
    transform: rotate(90deg);
  }
</style>

<section id="MainProduct-{{ section.id }}" class="product-section">
  <div class="product-grid">
    <div class="product__media-wrapper">
      <div class="product__media-main" id="MainMedia-{{ section.id }}">
        {% if hero_media %}
          <img
            src="{{ hero_media | image_url: width: 1000 }}"
            alt="{{ p.title | escape }}"
            id="ProductMainImage-{{ section.id }}"
            width="1000"
            height="{{ 1000 | divided_by: hero_media.aspect_ratio | ceil }}"
            loading="eager"
          >
        {% endif %}
      </div>

      {% if p.media.size > 1 %}
        <div class="product__thumbnails">
          {% for media in p.media limit: 6 %}
            <button
              class="thumb{% if forloop.first %} active{% endif %}"
              onclick="changeImage(this, '{{ media | image_url: width: 1000 }}')"
            >
              <img
                src="{{ media | image_url: width: 150 }}"
                alt="{{ media.alt | default: p.title | escape }}"
                width="150"
                height="{{ 150 | divided_by: media.aspect_ratio | ceil }}"
                loading="lazy"
              >
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="product__info-wrapper">
      <h1 class="product__title">{{ p.title | escape }}</h1>

      <div class="product__meta-desc">
        {% if product.metafields.global.description_tag != blank %}
          {{ product.metafields.global.description_tag }}
        {% else %}
          {{ product.description | strip_html | truncate: 160 }}
        {% endif %}
      </div>

      <div class="product__price">{{ v.price | money }}</div>

      <form method="post" action="{{ routes.cart_add_url }}">
        <input type="hidden" name="id" value="{{ v.id }}">

        {% unless p.has_only_default_variant %}
          {% for option in p.options_with_values %}
            <div class="product__option">
              <legend>{{ option.name }}</legend>

              {% for value in option.values %}
                <label class="product__swatch">
                  <input
                    type="radio"
                    name="option-{{ option.name }}"
                    value="{{ value }}"
                    {% if option.selected_value == value %}
                      checked
                    {% endif %}
                  >
                  <span>{{ value }}</span>
                </label>
              {% endfor %}
            </div>
          {% endfor %}
        {% endunless %}

        <div style="margin-top: 1rem; margin-bottom: 1.5rem;">
          <legend style="font-weight: 600; margin-bottom: 0.8rem; display: block;">Quantity</legend>
          <input type="number" name="quantity" value="1" min="1" style="width: 80px; padding: 10px; border: 1px solid #d1d5db; border-radius: 4px; font-size: 1.6rem;">
        </div>

        {%- comment -%}
          POD products (Printify, Printful, etc.) are made on demand.
          Never show Sold Out purely because inventory_quantity = 0.
          Only disable if the vendor explicitly marks the variant unavailable
          (discontinued/pulled from their catalog) AND it's not a POD vendor.
          Note: render snippets don't share scope, so we check the vendor here directly.
        {%- endcomment -%}
        {%- assign pod_vendors = 'Printify,Printful,AnywherePod,CustomCat,Gooten,Teespring,Redbubble,popcustoms,PopCustoms,POPCUSTOMS' | split: ',' -%}
        {%- assign section_is_pod = false -%}
        {%- for pod_v in pod_vendors -%}
          {%- if p.vendor == pod_v -%}
            {%- assign section_is_pod = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign truly_unavailable = false -%}
        {%- unless v.available -%}
          {%- unless section_is_pod -%}
            {%- assign truly_unavailable = true -%}
          {%- endunless -%}
        {%- endunless -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}

        <button
          type="submit"
          class="product__add-to-cart"
          {% if truly_unavailable %}disabled{% endif %}
        >
          {%- if truly_unavailable -%}
            Sold Out
          {%- elsif section_is_pod -%}
            Add to Cart
          {%- elsif v.available -%}
            Add to Cart
          {%- else -%}
            Sold Out
          {%- endif -%}
        </button>
      </form>

    </div>
  </div>
</section>

<div class="product-tabs-section">
  <div class="product-tabs" role="tablist">
    <div class="product-tabs__nav">
      <button
        class="product-tab-button is-active"
        role="tab"
        aria-selected="true"
        aria-controls="tab-description-{{ section.id }}"
        tabindex="0"
      >Description</button>
      <button
        class="product-tab-button"
        role="tab"
        aria-selected="false"
        aria-controls="tab-shipping-{{ section.id }}"
        tabindex="-1"
      >Shipping & Returns</button>
      {%- if product.metafields.custom.faq != blank -%}
        <button
          class="product-tab-button"
          role="tab"
          aria-selected="false"
          aria-controls="tab-faq-{{ section.id }}"
          tabindex="-1"
        >FAQ</button>
      {%- endif -%}
    </div>

    <div
      id="tab-description-{{ section.id }}"
      class="product-tab-panel rte"
      role="tabpanel"
      aria-hidden="false"
    >
      {{ p.description }}
    </div>

    <div
      id="tab-shipping-{{ section.id }}"
      class="product-tab-panel is-hidden"
      role="tabpanel"
      aria-hidden="true"
    >
      <strong>Production & Shipping</strong>
      <p>Every piece of apparel is custom-made on demand when you order it. This means your gear is fresh off the press and crafted with care.</p>
      <p>
        <strong>Production Time:</strong> 3–5 business days<br>
        <strong>Shipping Time:</strong> 5–7 business days (Standard US)
      </p>
      <p><em>Note: Drinkware and home goods may ship separately from our ready-to-ship facilities.</em></p>
    </div>

    {%- if product.metafields.custom.faq != blank -%}
      <div
        id="tab-faq-{{ section.id }}"
        class="product-tab-panel is-hidden"
        role="tabpanel"
        aria-hidden="true"
      >
        {%- assign faq_lines = product.metafields.custom.faq | split: '\n' -%}
        {%- for line in faq_lines -%}
          {%- assign qa = line | split: 'A:' -%}
          {%- if qa.size > 1 -%}
            {%- assign q = qa[0] | remove: 'Q:' | strip -%}
            {%- assign a = qa[1] | strip -%}
            <div class="faq-item">
              <div class="faq-question">{{ q }}<span class="faq-arrow">▶</span></div>
              <div class="faq-answer">{{ a }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  function changeImage(btn, src) {
    document.getElementById('ProductMainImage-{{ section.id }}').src = src;
    document.querySelectorAll('.thumb').forEach((t) => t.classList.remove('active'));
    btn.classList.add('active');
  }

  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.faq-question').forEach((item) => {
      item.addEventListener('click', function () {
        let parent = this.parentElement;
        let answer = parent.querySelector('.faq-answer');

        if (answer.style.display === 'block') {
          answer.style.display = 'none';
          parent.classList.remove('faq-open');
        } else {
          answer.style.display = 'block';
          parent.classList.add('faq-open');
        }
      });
    });
  });
</script>

{%- comment -%} Structured data is now handled via snippets/structured-product.liquid {%- endcomment -%}

{% schema %}
{
  "name": "Main Product (With FAQ )",
  "settings": [],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [{ "name": "Main Product (With FAQ Accordion)" }]
}
{% endschema %}