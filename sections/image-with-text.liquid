{%- comment -%}
/sections/image-with-text.liquid
Image with Text — optimized + complete schema
- Uses snippets/optimized-image.liquid (responsive srcset + width/height → zero CLS)
- No hardcoded "900x600" strings
- Clean schema (no truncation), presets included
- Button "open in new tab" is per-block (not section-level) to avoid missing setting references
- Styles externalized to assets/section-image-with-text.css
{%- endcomment -%}

{{ 'section-image-with-text.css' | asset_url | stylesheet_tag: preload: true, onload: "this.media='all'" }}
<noscript>{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}</noscript>

<section
  class="section image-with-text color-{{ section.settings.color_scheme }} {{ section.settings.content_layout }} {{ section.settings.height }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="image-with-text__container{% if section.settings.layout == 'text_first' %} image-with-text__reverse{% endif %}">
    {%- if section.settings.image -%}
      <div
        class="image-with-text__media image-width-{{ section.settings.desktop_image_width }} image-animation-{{ section.settings.image_behavior }}"
        style="flex:0 0 auto;"
      >
        {% render 'optimized-image',
          image: section.settings.image,
          alt: section.settings.image_alt | default: 'Section image' | escape,
          class: 'image-with-text__img',
          sizes: '(max-width: 989px) 100vw, 50vw',
          width_override: 1800,
          loading: 'lazy',
          decoding: 'async'
        %}
      </div>
    {%- endif -%}

    <div
      class="image-with-text__content align-{{ section.settings.desktop_content_alignment }} align-mobile-{{ section.settings.mobile_content_alignment }} valign-{{ section.settings.desktop_content_position }}"
    >
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- assign heading_tag = block.settings.heading_size | default: 'h2' -%}
            <{{ heading_tag }} class="image-with-text__heading">
              {{ block.settings.heading | escape }}
            </{{ heading_tag }}>
          {%- when 'caption' -%}
            <div class="image-with-text__caption text-{{ block.settings.text_style }} size-{{ block.settings.text_size }}">
              {{ block.settings.caption | escape }}
            </div>
          {%- when 'text' -%}
            <div class="image-with-text__desc text-{{ block.settings.text_style }}">
              {{ block.settings.text }}
            </div>
          {%- when 'button' -%}
            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              <a
                href="{{ block.settings.button_link }}"
                class="image-with-text__button button{% if block.settings.button_style_secondary %} button--secondary{% endif %}"
                {% if block.settings.button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
              >
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with Text",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "select",
      "id": "content_layout",
      "label": "Content layout",
      "default": "no-overlap",
      "options": [
        { "value": "no-overlap", "label": "No overlap" },
        { "value": "overlap", "label": "Overlap" }
      ]
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Section image" },
    {
      "type": "select",
      "id": "image_behavior",
      "label": "Image animation",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "zoom-in", "label": "Zoom in" },
        { "value": "ambient", "label": "Ambient motion" }
      ]
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section height",
      "default": "adapt",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ]
    },
    {
      "type": "select",
      "id": "desktop_image_width",
      "label": "Image width on desktop",
      "default": "medium",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ]
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "label": "Content vertical alignment",
      "default": "middle",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "default": "image_first",
      "options": [
        { "value": "image_first", "label": "Image first" },
        { "value": "text_first", "label": "Text first" }
      ]
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "label": "Content alignment (desktop)",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "label": "Content alignment (mobile)",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Image with text" },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "default": "h2",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" }
          ]
        }
      ]
    },
    {
      "type": "caption",
      "name": "Caption",
      "settings": [
        { "type": "text", "id": "caption", "label": "Caption", "default": "Optional caption" },
        {
          "type": "select",
          "id": "text_style",
          "label": "Text style",
          "default": "body",
          "options": [
            { "value": "body", "label": "Body" },
            { "value": "subtitle", "label": "Subtitle" }
          ]
        },
        {
          "type": "select",
          "id": "text_size",
          "label": "Text size",
          "default": "md",
          "options": [
            { "value": "sm", "label": "Small" },
            { "value": "md", "label": "Medium" },
            { "value": "lg", "label": "Large" }
          ]
        }
      ]
    },
    {
      "type": "text",
      "name": "Rich text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add your description here.</p>"
        },
        {
          "type": "select",
          "id": "text_style",
          "label": "Text style",
          "default": "body",
          "options": [
            { "value": "body", "label": "Body" },
            { "value": "subtitle", "label": "Subtitle" }
          ]
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn more" },
        { "type": "url",  "id": "button_link",  "label": "Button link" },
        { "type": "checkbox", "id": "button_style_secondary", "label": "Secondary style", "default": false },
        { "type": "checkbox", "id": "button_new_tab", "label": "Open in new tab", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with Text",
      "blocks": [
        { "type": "heading" },
        { "type": "caption" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}