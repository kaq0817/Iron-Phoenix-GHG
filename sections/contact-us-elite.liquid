    { "type": "text", "id": "biz_sms_number_label", "label": "Business Phone", "default": "(307) 439-5613 (Text Only)" },
    { "type": "text", "id": "biz_sms_number_uri", "label": "Business Phone URI", "default": "+13074395613" },

    { "type": "header", "content": "Response Time" },
    { "type": "text", "id": "response_time_title", "label": "Response Title", "default": "Response Time & Service Area 🕒" },
    { "type": "text", "id": "our_support_team_message", "label": "Support Message", "default": "Our customer support team is available during the following hours:" },
    { "type": "text", "id": "customer_support_hours", "label": "Support Hours", "default": "Daily, 9:00 AM – 10:00 PM EST" },
