    { "type": "text", "id": "store_hours_section_title", "label": "Hours Title", "default": "Store Hours" },
    { "type": "text", "id": "online_store_status_text", "label": "Store Status", "default": "Open 24/7." },
    { "type": "text", "id": "order_processing_status_text", "label": "Processing Status", "default": "Within 8 business hours." },

    { "type": "header", "content": "Join Community" },
    { "type": "text", "id": "join_community_section_title", "label": "Community Title", "default": "Join Our Community" },
    { "type": "richtext", "id": "join_community_text_richtext", "label": "Community Text", "default": "<p>Join us on Discord for gaming fun!</p>" },

    { "type": "header", "content": "JSON-LD" },
    { "type": "checkbox", "id": "include_full_address_in_schema", "label": "Include Full Address", "default": false },
    { "type": "text", "id": "street_address", "label": "Street Address", "default": "123 Main St" },
    { "type": "text", "id": "public_phone", "label": "Public Phone", "default": "+1-518-415-8496" },

    { "type": "header", "content": "Contact Form" },
    { "type": "checkbox", "id": "show_form", "label": "Show Form", "default": false },
    { "type": "range", "id": "min_dwell_ms", "min": 0, "max": 8000, "step": 250, "unit": "ms", "label": "Dwell Time", "default": 2500 },

