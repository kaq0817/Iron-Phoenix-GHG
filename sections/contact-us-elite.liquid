    { "type": "header", "content": "Company Details" },
    { "type": "text", "id": "company_details_title", "label": "Company Title", "default": "Company Details" },
    { "type": "text", "id": "city", "label": "City", "default": "Ballston Spa" },
    { "type": "text", "id": "region", "label": "Region", "default": "NY" },
