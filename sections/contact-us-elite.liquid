    { "type": "text", "id": "support_email", "label": "Support Email", "default": "support@ironphoenix.store" },
    { "type": "text", "id": "support_sms_number_label", "label": "Support Phone", "default": "(518) 415-8496 (Text Only)" },
    { "type": "text", "id": "support_sms_number_uri", "label": "Support Phone URI", "default": "+15184158496" },

    { "type": "text", "id": "biz_inquiries_section_title", "label": "Business Title", "default": "Business Inquiries (Text Only)" },
    { "type": "text", "id": "biz_inquiries_section_text", "label": "Business Text", "default": "For proposals or collaborations:" },
