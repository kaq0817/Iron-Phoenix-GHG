{%- comment -%}
  sections/main-search.liquid
  - Accessible search form (uses routes.search_url)
  - Optional: limit results to products only
  - Product grid renders with existing 'card-product' snippet
  - No Liquid in inline JS (theme-check safe); JS is loaded via assets
{%- endcomment -%}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<section class="section page-width" aria-labelledby="search-title" data-section-id="{{ section.id }}">
  <header class="search-header" style="margin:2rem 0;">
    <h1 id="search-title" class="h2" style="margin:0 0 1rem;">
      {{ 'general.search.search' | t | default: 'Search' | escape }}
    </h1>

    <form role="search"
          class="search-form"
          action="{{ routes.search_url }}"
          method="get"
          aria-label="{{ 'general.search.search' | t | default: 'Search the store' | escape }}"
          data-predictive-enabled="{{ settings.predictive_search_enabled }}"
    >
      <div class="search-form__row" style="display:flex;gap:0.75rem;">
        <input class="search-form__input"
               type="search"
               name="q"
               value="{{ search.terms | escape }}"
               placeholder="{{ 'general.search.search' | t | default: 'Search products…' | escape }}"
               aria-label="{{ 'general.search.search' | t | default: 'Search products' | escape }}"
               autocomplete="off"
               style="flex:1;min-width:180px;">
        {%- if section.settings.only_products -%}
          <input type="hidden" name="type" value="product">
        {%- endif -%}
        <button class="button" type="submit">
          {{ 'general.search.submit' | t | default: 'Search' | escape }}
        </button>
      </div>
    </form>

    {%- if search.performed -%}
      <p class="search-summary" style="margin:1rem 0 0;opacity:.8;">
        {{ 'general.search.results_with_count' | t: terms: search.terms, count: search.results_count | default: 'Results for' | escape }}
        {% if search.terms != blank %}“{{ search.terms | escape }}”{% endif %}
        — {{ search.results_count }}
      </p>
    {%- endif -%}
  </header>

  {%- if search.performed -%}
    {%- paginate search.results by section.settings.results_per_page -%}
      {%- assign product_results = search.results | where: 'object_type', 'product' -%}
      {%- assign non_product_results = search.results | reject: 'object_type', 'product' -%}

      {%- if section.settings.only_products -%}
        {%- assign listing = product_results -%}
      {%- else -%}
        {%- assign listing = search.results -%}
      {%- endif -%}

      {%- if listing.size > 0 -%}
        <div class="search-results">
          {%- if section.settings.only_products -%}
            <ul id="product-grid"
                class="grid product-grid grid--2-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
                role="list"
                style="gap:2rem;">
              {%- assign skip_card_product_styles = false -%}
              {%- for item in listing -%}
                {%- comment -%} listing is already products only {%- endcomment -%}
                <li class="grid__item">
                  {%- render 'render-card-product',
                    card_product: item,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    skip_styles: skip_card_product_styles,
                    section_id: section.id
                  -%}
                </li>
                {%- assign skip_card_product_styles = true -%}
              {%- endfor -%}
            </ul>
          {%- else -%}
            {%- comment -%} Mixed results: show products as a grid, then pages/articles as links {%- endcomment -%}
            {%- if product_results.size > 0 -%}
              <h2 class="h3" style="margin:2rem 0 1rem;">
                {{ 'general.search.products' | t | default: 'Products' | escape }}
              </h2>
              <ul id="product-grid"
                  class="grid product-grid grid--2-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
                  role="list"
                  style="gap:2rem;">
                {%- assign skip_card_product_styles = false -%}
                {%- for p in product_results -%}
                  <li class="grid__item">
                    {%- render 'render-card-product',
                      card_product: p,
                      media_aspect_ratio: section.settings.image_ratio,
                      image_shape: section.settings.image_shape,
                      show_secondary_image: section.settings.show_secondary_image,
                      show_vendor: section.settings.show_vendor,
                      show_rating: section.settings.show_rating,
                      skip_styles: skip_card_product_styles,
                      section_id: section.id
                    -%}
                  </li>
                  {%- assign skip_card_product_styles = true -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if non_product_results.size > 0 -%}
              <h2 class="h3" style="margin:2rem 0 1rem;">
                {{ 'general.search.more_results' | t | default: 'Other results' | escape }}
              </h2>
              <ul role="list" class="search-links" style="display:grid;gap:0.75rem;">
                {%- for r in non_product_results -%}
                  <li>
                    <a class="link" href="{{ r.url | escape }}">
                      {{ r.title | strip_html | escape }}
                    </a>
                    {%- if r.object_type == 'article' and r.excerpt != blank -%}
                      <div class="rte" style="opacity:.8;margin-top:.25rem;">
                        {{ r.excerpt | strip_html | truncate: 140 | escape }}
                      </div>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t | default: 'Pagination' | escape }}">
            {{ paginate | default_pagination }}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="search-empty" style="text-align:center;padding:3rem 1rem;">
          <p style="opacity:.8;">
            {{ 'general.search.no_results' | t | default: 'No results found.' | escape }}
          </p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- else -%}
    <div class="search-empty" style="text-align:center;padding:3rem 1rem;opacity:.85;">
      {{ 'general.search.instructions' | t | default: 'Type in the box above and press Enter.' | escape }}
    </div>
  {%- endif -%}
</section>

<script src="{{ 'search-form.js' | asset_url }}" defer></script>
<script src="{{ 'main-search.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Main search",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "only_products",
      "label": "Show only products",
      "default": true
    },
    {
      "type": "range",
      "id": "results_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16,
      "label": "Results per page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Product columns (desktop)"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "adapt",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ]
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "round", "label": "Round" },
        { "value": "arch", "label": "Arch" },
        { "value": "blob", "label": "Blob" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show secondary image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": false
    }
  ],
  "enabled_on": {
    "templates": ["search"]
  }
}
{% endschema %}
