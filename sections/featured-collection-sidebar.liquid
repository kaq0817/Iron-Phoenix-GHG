{% comment %}
  Sidebar: Featured Collections (safe)
{% endcomment %}

{{ 'section-featured-collection-sidebar.css' | asset_url | stylesheet_tag }}

<aside class="blog-sidebar-featured-collections">
  {% if section.settings.heading != blank %}
    <h2 class="sidebar-heading">{{ section.settings.heading | escape }}</h2>
  {% endif %}

  <div class="sidebar-featured-collections-list">
    {% for block in section.blocks %}
      {% assign col = block.settings.collection %}
      <div class="sidebar-featured-collection-card" {{ block.shopify_attributes }}>
        {% if col %}
          <a href="{{ col.url | escape }}">
            {% if col.image %}
              {%- render 'optimized-image',
                image: col.image,
                alt: col.title,
                width_override: 120,
                class: 'sidebar-featured-collection-card__image'
              -%}
            {% endif %}
            <div>
              <div>{{ col.title | escape }}</div>
              <div>{{ col.description | strip_html | truncate: 55 | escape }}</div>
            </div>
          </a>
        {% else %}
          <div>
            <div>Choose a collection</div>
            <div class="muted">Add one in the block settings.</div>
          </div>
        {% endif %}
      </div>
    {% endfor %}

    {% if section.blocks.size == 0 %}
      <div>No featured collections set. Add them in the theme editor!</div>
    {% endif %}
  </div>
</aside>

{% schema %}
{
  "name": "Sidebar Collections",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Sidebar Heading",
      "default": "Shop Collections"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    { "name": "Sidebar Collections" }
  ]
}
{% endschema %}
