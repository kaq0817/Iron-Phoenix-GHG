{% comment %}
  Home Hero + CTA (fast + accessible) — styles in assets/section-home-hero-optin.css
{% endcomment %}

{% comment %}
  CRITICAL FIX: Replacing multi-argument stylesheet_tag with manual link tags
  to avoid Liquid syntax errors.
{% endcomment %}
{{ 'section-home-hero-optin.css' | asset_url | stylesheet_tag: preload: true }}

<section class="home-hero color-{{ section.settings.color_scheme }}">
  <div class="home-hero__media" aria-hidden="true">
    {% assign img = section.settings.desktop_image %}
    {% if img %}
      {% assign hero_alt = section.settings.alt_text | default: section.settings.heading | escape %}
      {% comment %}
        Important: hero_h needs to be calculated from img.width and img.aspect_ratio
        to ensure correct aspect ratio, not just img.height directly if img.height is not guaranteed.
      {% endcomment %}
      {% assign hero_w = img.width %}
      {% assign hero_h = img.width | divided_by: img.aspect_ratio | round %}

      {% comment %}
        CRITICAL FIX: Replacing multi-argument image_tag with manual <img> tag
        to avoid Liquid syntax errors.
        Building srcset manually.
      {% endcomment %}
      {%- assign srcset_widths = '750,1100,1500,2000' | split: ',' -%}
      {%- assign srcset_str = '' -%}
      {%- for width in srcset_widths -%}
        {%- assign srcset_str = srcset_str
          | append: img
          | image_url: width: width
          | append: ' '
          | append: width
          | append: 'w'
        -%}
        {%- unless forloop.last -%}{%- assign srcset_str = srcset_str | append: ',' -%}{%- endunless -%}
      {%- endfor -%}

      <img
        src="{{ img | image_url: width: 2000 }}"
        srcset="{{ srcset_str }}"
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        alt="{{ hero_alt }}"
        width="{{ hero_w }}"
        height="{{ hero_h }}"
        class="home-hero__img"
      >
    {% endif %}
  </div>

  <div class="page-width home-hero__inner text-{{ section.settings.text_align }}">
    {% if section.settings.eyebrow != blank %}
      <p class="home-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="home-hero__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="home-hero__sub">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="home-hero__ctas">
      {% if section.settings.primary_label and section.settings.primary_link %}
        <a class="btn btn--primary" href="{{ section.settings.primary_link | escape }}">
          {{- section.settings.primary_label | escape -}}
        </a>
      {% endif %}
      {% if section.settings.secondary_label and section.settings.secondary_link %}
        <a class="btn btn--ghost" href="{{ section.settings.secondary_link | escape }}">
          {{- section.settings.secondary_label | escape -}}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New arrivals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rise. Play. Thrive." },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Gaming • Sports & Wellness • Creator Tools</p>"
    },
    { "type": "image_picker", "id": "desktop_image", "label": "Background image" },
    { "type": "text", "id": "alt_text", "label": "Background alt text" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "primary_label", "label": "Primary label", "default": "Shop featured" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "Join free" },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" }
  ],
  "presets": [{ "name": "Home hero" }]
}
{% endschema %}
