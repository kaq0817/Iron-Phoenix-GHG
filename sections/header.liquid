<!-- /sections/header.liquid -->
{% comment %}
  Drawer-only header; calls snippets/menu-drawer.liquid
  Styles externalized to assets/section-header.css
  Uses theme's global CSS variables for colors
{% endcomment %}

<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-cart-notification.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'component-menu-drawer.css' | asset_url | stylesheet_tag }}</noscript>
<link rel="stylesheet" href="{{ 'section-header.css' | asset_url }}" media="print" onload="this.media='all'"> {# Link to new external CSS #}
<noscript>{{ 'section-header.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  /* Define CSS variables for padding and margin dynamically from section settings */
  .header-wrapper {
    --header-padding-top-mobile: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    --header-padding-bottom-mobile: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
    --header-margin-bottom-mobile: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    --header-padding-top-desktop: {{ section.settings.padding_top }}px;
    --header-padding-bottom-desktop: {{ section.settings.padding_bottom }}px;
    --header-margin-bottom-desktop: {{ section.settings.margin_bottom }}px;
  }
{%- endstyle -%}

<script src="{{ 'menu-drawer.js' | asset_url }}" defer></script>
<script src="{{ 'cart-notification.js' | asset_url }}" defer></script>

{%- assign header_tag = 'div' -%}
{%- if section.settings.sticky_header_type != 'none' -%}{%- assign header_tag = 'sticky-header' -%}{%- endif -%}

<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}data-sticky-type="{{ section.settings.sticky_header_type }}"{% endif %}
  class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}"
>
  {% if section.settings.show_announcement %}{% render 'announcement-bar' %}{% endif %}

  <header class="header page-width section-header-wrapper"> {# Apply header-wrapper class for margin/padding #}
    <div class="header__bar">
      <!-- Logo -->
      <div class="header__logo">
        {%- if request.page_type == 'index' -%}<h1 class="header__heading">{%- endif -%}
        <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
          {%- if section.settings.logo -%}
            {%- assign logo_alt = section.settings.logo_alt | default: shop.name | escape -%}
            {%- assign logo_height = settings.logo_width | default: 140 | divided_by: section.settings.logo.aspect_ratio -%}
            {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 | default: 280 }}px) 50vw, {{ settings.logo_width | default: 140 }}px{% endcapture %}
            {% capture widths %}{{ settings.logo_width | default: 140 }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
            {{
              section.settings.logo
              | image_url: width: 600
              | image_tag:
                class: 'header__heading-logo motion-reduce',
                widths: widths,
                height: logo_height,
                width: settings.logo_width | default: 140,
                alt: logo_alt,
                sizes: sizes,
                preload: true
            }}
          {%- else -%}
            <span class="h2">{{ shop.name | escape }}</span>
          {%- endif -%}
        </a>
        {%- if request.page_type == 'index' -%}</h1>{%- endif -%}
      </div>

      <!-- Icons -->
      <div class="header__icons">
        {% render 'header-search', input_id: 'Search-In-Modal' %}

        {% if shop.customer_accounts_enabled %}
          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
             class="header__icon header__icon--account link focus-inset"
             rel="nofollow" aria-label="Account">
            <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
          </a>
        {% endif %}

        <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble" aria-label="Cart" style="position:relative">
          {% if cart == empty %}
            <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
          {% else %}
            <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
          {% endif %}
          <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
          {% if cart != empty %}
            <div class="cart-count-bubble">
              {% if cart.item_count < 100 %}
                <span aria-hidden="true">{{ cart.item_count | escape }}</span>
              {% endif %}
              <span class="visually-hidden">
                {% if cart.item_count == 1 %}1 item in your cart{% else %}{{ cart.item_count | escape }} items in your cart{% endif %}
              </span>
            </div>
          {% endif %}
        </a>

        <button id="menu-drawer-toggle" class="header__icon header__icon--menu"
                aria-label="{{ 'sections.header.menu' | t | default: 'Menu' }}"
                aria-controls="MenuDrawer" aria-expanded="false">
          <span class="svg-wrapper">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="4" y="7" width="16" height="2" rx="1" fill="currentColor"/>
              <rect x="4" y="15" width="16" height="2" rx="1" fill="currentColor"/>
            </svg>
          </span>
        </button>
      </div>
    </div>
  </header>

  {%- render 'header-search' -%}
  {%- render 'menu-drawer', menu: section.settings.menu -%}
</{{ header_tag }}>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "logo_alt", "label": "Logo Alt Text", "default": "Site logo" },
    { "type": "link_list", "id": "menu", "label": "Navigation menu", "default": "main-menu" },
    { "type": "select", "id": "sticky_header_type", "label": "Sticky header type",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "on-scroll-up", "label": "On scroll up" },
        { "value": "always", "label": "Always" },
        { "value": "reduce-logo-size", "label": "Reduce logo size" }
      ],
      "default": "on-scroll-up"
    },
    { "type": "checkbox", "id": "show_line_separator", "label": "Show line separator", "default": true },
    { "type": "checkbox", "id": "show_announcement", "label": "Show announcement bar", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "margin_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Margin bottom", "default": 0 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 36, "step": 4, "unit": "px", "label": "Padding top", "default": 20 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 36, "step": 4, "unit": "px", "label": "Padding bottom", "default": 20 }
  ],
  "blocks": []
}
{% endschema %}

{% javascript %}
  /* StickyHeader custom element (no duplicate listeners on section reload) */
  class StickyHeader extends HTMLElement {
    connectedCallback() {
      this.header = document.querySelector('.section-header-wrapper');
      this.headerIsAlwaysSticky =
        this.getAttribute('data-sticky-type') === 'always' ||
        this.getAttribute('data-sticky-type') === 'reduce-logo-size';
      this.headerBounds = {};
      this.setHeaderHeight();
      window.matchMedia('(max-width: 990px)').addEventListener('change', this.setHeaderHeight.bind(this));
      if (this.headerIsAlwaysSticky) this.header.classList.add('shopify-section-header-sticky');
      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');
      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => (this.preventReveal = true);
      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);
      this.createObserver();
    }
    setHeaderHeight(){ document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`); }
    disconnectedCallback(){ this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp); window.removeEventListener('scroll', this.onScrollHandler); }
    createObserver(){ let o=new IntersectionObserver((e,obs)=>{ this.headerBounds=e[0].intersectionRect; obs.disconnect(); }); o.observe(this.header); }
    onScroll(){
      const y = window.pageYOffset || document.documentElement.scrollTop;
      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;
      if (y > this.currentScrollTop && y > this.headerBounds.bottom){
        this.header.classList.add('scrolled-past-header'); if (this.preventHide) return; requestAnimationFrame(this.hide.bind(this));
      } else if (y < this.currentScrollTop && y > this.headerBounds.bottom){
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal){ requestAnimationFrame(this.reveal.bind(this)); }
        else { window.clearTimeout(this.isScrolling); this.isScrolling=setTimeout(()=>{ this.preventReveal=false; },66); requestAnimationFrame(this.hide.bind(this)); }
      } else if (y <= this.headerBounds.top){
        this.header.classList.remove('scrolled-past-header'); requestAnimationFrame(this.reset.bind(this));
      }
      this.currentScrollTop = y;
    }
    hide(){ if (this.headerIsAlwaysSticky) return; this.header.classList.add('shopify-section-header-hidden','shopify-section-header-sticky'); }
    reveal(){ if (this.headerIsAlwaysSticky) return; this.header.classList.add('shopify-section-header-sticky','animate'); this.header.classList.remove('shopify-section-header-hidden'); }
    reset(){ if (this.headerIsAlwaysSticky) return; this.header.classList.remove('shopify-section-header-hidden','shopify-section-header-sticky','animate'); }
  }
  customElements.define('sticky-header', StickyHeader);
{% endjavascript %}