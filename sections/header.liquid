{%- comment -%}
  File: sections/header.liquid
  Updated: square logo support, no background box, clean tagline alignment
{%- endcomment -%}

{%- liquid
  assign logo_img = section.settings.logo
  assign logo_w = section.settings.logo_size | default: settings.logo_width | default: 80
-%}

<style>
  .header-wrapper {
    position: relative !important;
    top: auto !important;
    z-index: 100 !important;
    width: 100% !important;
    background: {{ section.settings.header_bg_color | default: '#050b12' }} !important;
    border-bottom: 1px solid {{ section.settings.header_border_color | default: '#1a2433' }} !important;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: nowrap;
    gap: 10px;
    min-height: 100px;
    padding: 20px 30px;
    background: {{ section.settings.header_bg_color | default: '#050b12' }} !important;
    color: #fff !important;
    border-bottom: none !important;
    box-shadow: none !important;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  @media screen and (min-width: 750px) {
    .header {
      padding: var(--header-padding-top-desktop, 32px) 40px var(--header-padding-bottom-desktop, 32px);
    }
  }

  /* LOGO + TAGLINE GROUP */
  .header__logo {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  /* SQUARE LOGO — NO BACKGROUND BOX */
  .header__heading-link img {
    width: {{ logo_w }}px;
    height: {{ logo_w }}px;
    object-fit: contain;
    display: block;
  }

  .header__tagline {
    font-size: {{ section.settings.tagline_size | default: 11 }}px;
    font-weight: 600;
    text-transform: uppercase;
    white-space: nowrap;
    color: #fff !important;
  }

  @media screen and (max-width: 600px) {
    .header__tagline {
      font-size: 0.9rem;
      max-width: 160px;
      white-space: normal;
      line-height: 1.2;
    }
  }

  /* INLINE NAV */
  .header__inline-menu {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .header__inline-menu {
      display: block;
      flex: 1 1 auto;
    }

    .list-menu--inline {
      display: flex;
      justify-content: center;
      gap: 2rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .header__menu-item {
      color: #ffffff;
      text-decoration: none;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      display: flex;
      align-items: center;
      gap: 5px;
      transition: opacity 0.2s ease;
    }

    .header__menu-item:hover {
      opacity: 0.7;
    }
  }

  /* ICON GROUP */
  .header__icons {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .header__icon {
    color: #fff;
    background: transparent;
    border: none;
    cursor: pointer;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }

  .header__icon:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* SEARCH INPUT */
  .header-search input[type='search'] {
    width: 100%;
    padding: 6px 10px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    outline: none;
    background: transparent;
    color: #fff;
  }

  .header-search input::placeholder {
    color: rgba(255, 255, 255, 0.7);
  }

  .header-search {
    flex: 1 1 200px;
    min-width: 0;
  }

  @media screen and (max-width: 600px) {
    .header {
      flex-wrap: wrap;
      padding-left: 12px;
      padding-right: 12px;
    }

    .header__logo {
      width: 100%;
      justify-content: space-between;
      gap: 8px;
    }

    .header__tagline {
      font-size: 0.82rem;
      max-width: 180px;
      text-align: right;
    }

    .header__icons {
      width: 100%;
      gap: 0.45rem;
    }

    .header__icon {
      width: 34px;
      height: 34px;
      flex: 0 0 34px;
    }
  }

  @media screen and (max-width: 420px) {
    .header__tagline {
      display: none;
    }
  }

  /* Hide Shopify's cart notification */
  .cart-notification-wrapper,
  .cart-notification,
  #cart-notification {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    height: 0 !important;
    pointer-events: none !important;
  }

  .section-block {
    padding: 64px 0;
  }
  .section-block--navy {
    background: #050b12;
  }
  .section-block--purple {
    background: #36124e;
  }
  .section-block--lightblue {
    background: #888ec1;
  }

  .page-width {
    max-width: 1240px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }
</style>

<div class="header-wrapper">
  <header
    class="header"
    style="
      --header-padding-top-mobile: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
      --header-padding-bottom-mobile: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
      --header-padding-top-desktop: {{ section.settings.padding_top }}px;
      --header-padding-bottom-desktop: {{ section.settings.padding_bottom }}px;
    "
  >
    <!-- LOGO + TAGLINE -->
    <div class="header__logo">
      <a href="{{ routes.root_url }}" class="header__heading-link">
        {% if logo_img %}
          <img
            src="{{ logo_img | image_url: width: logo_w }}"
            width="{{ logo_w }}"
            height="{{ logo_w }}"
            alt="{{ section.settings.logo_alt | default: shop.name | escape }}"
            loading="eager"
            decoding="async"
          >
        {% else %}
            <span class="h2">{{ shop.name | replace: 'Go Hard Gaming Discord LLC', 'Go Hard Gaming Discord LLC' }}</span>
        {% endif %}
      </a>

      {%- if section.settings.tagline != blank -%}
        <span class="header__tagline" style="color: {{ section.settings.tagline_color | default: '#ffffff' }}">{{ section.settings.tagline | escape }}</span>
      {%- endif -%}
    </div>

    <!-- INLINE NAV (Editable Blocks) -->
    <nav class="header__inline-menu">
      <ul class="list-menu list-menu--inline" role="list">
        {%- for block in section.blocks -%}
          <li>
            <a href="{{ block.settings.link | default: '#' }}" class="header__menu-item" {{ block.shopify_attributes }}>
              <span>{{ block.settings.label | escape }}</span>
              {%- if block.settings.show_down_arrow -%}
                <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5"/></svg>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <!-- ICONS -->
    <div class="header__icons">
      <form role="search" class="header-search" action="{{ routes.search_url }}" method="get">
        <input type="search" name="q" placeholder="Search..." aria-label="Search">
        <input type="hidden" name="contact[Source_ID]" value="phoenix-flow-tracked">
      </form>

      <a href="{{ routes.cart_url }}" aria-label="Cart" style="display:flex;align-items:center;justify-content:center;padding:8px;line-height:0;">
        <svg width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 3h2l.4 2m0 0L7 13h12l2-8H5.4Z" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="9" cy="18" r="1.5" fill="#ffffff"/>
          <circle cx="16" cy="18" r="1.5" fill="#ffffff"/>
        </svg>
      </a>

      <button
        type="button"
        id="menu-drawer-toggle"
        aria-label="Open menu"
        aria-controls="menu-drawer"
        aria-expanded="false"
        style="background:none;border:none;cursor:pointer;padding:8px;display:flex;align-items:center;justify-content:center;line-height:0;"
      >
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="3" y="7" width="22" height="2.5" rx="1.25" fill="#ffffff"/>
          <rect x="3" y="13" width="22" height="2.5" rx="1.25" fill="#ffffff"/>
          <rect x="3" y="19" width="22" height="2.5" rx="1.25" fill="#ffffff"/>
        </svg>
      </button>
    </div>
  </header>
</div>

{% render 'menu-drawer', menu: section.settings.menu %}

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "text", "id": "logo_alt", "label": "Logo alt text", "default": "Site logo" },
    {
      "type": "range",
      "id": "logo_size",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Logo size",
      "default": 80
    },
    { "type": "header", "content": "Tagline" },
    { "type": "text", "id": "tagline", "label": "Tagline text", "default": "Reminding You to Use Your Imagination" },
    { "type": "color", "id": "tagline_color", "label": "Tagline color", "default": "#ffffff" },
    {
      "type": "range",
      "id": "tagline_size",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Tagline font size (px)",
      "default": 11
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "header_bg_color", "label": "Header background color", "default": "#111111" },
    { "type": "color", "id": "header_border_color", "label": "Header bottom border color", "default": "#222222" },
    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "show_line_separator", "label": "Show line separator", "default": false },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 24
    }
  ]
  ,
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Link label", "default": "Menu" },
        { "type": "url", "id": "link", "label": "Link URL" },
        { "type": "checkbox", "id": "show_down_arrow", "label": "Show down arrow (dropdown)", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        { "type": "nav_link" },
        { "type": "nav_link" },
        { "type": "nav_link" }
      ]
    }
  ]
}
{% endschema %}
