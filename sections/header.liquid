{%- comment -%}
  File: sections/header.liquid
  Updated: square logo support, no background box, clean tagline alignment
{%- endcomment -%}

{%- liquid
  assign logo_img = section.settings.logo
  assign logo_w = section.settings.logo_size | default: settings.logo_width | default: 80
-%}

<style>
  .header-wrapper {
    position: relative !important;
    top: auto !important;
    z-index: 100 !important;
    width: 100% !important;
    background: {{ section.settings.header_bg_color | default: '#26a69a' }} !important;
    border-bottom: 2px solid {{ section.settings.header_border_color | default: '#26A69A' }} !important;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: nowrap;
    gap: 10px;
    min-height: 100px;
    padding: 20px 30px;
    background: {{ section.settings.header_bg_color | default: '#26a69a' }} !important;
    color: #fff !important;
    border-bottom: none !important;
    box-shadow: none !important;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  @media screen and (min-width: 750px) {
    .header {
      padding: var(--header-padding-top-desktop, 32px) 40px var(--header-padding-bottom-desktop, 32px);
    }
  }

  /* LOGO + TAGLINE GROUP */
  .header__logo {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  /* SQUARE LOGO — NO BACKGROUND BOX */
  .header__heading-link img {
    width: {{ logo_w }}px;
    height: {{ logo_w }}px;
    object-fit: contain;
    display: block;
  }

  .header__tagline {
    font-size: {{ section.settings.tagline_size | default: 11 }}px;
    font-weight: 600;
    text-transform: uppercase;
    white-space: nowrap;
    color: #fff !important;
  }

  @media screen and (max-width: 600px) {
    .header__tagline {
      font-size: 0.9rem;
      max-width: 160px;
      white-space: normal;
      line-height: 1.2;
    }
  }

  /* ICON GROUP */
  .header__icons {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .header__icon {
    color: #fff;
    background: transparent;
    border: none;
    cursor: pointer;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }

  .header__icon:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* SEARCH INPUT */
  .header-search input[type='search'] {
    width: 100%;
    padding: 6px 10px;
    border-radius: 6px;
    border: none;
    outline: none;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
  }

  .header-search input::placeholder {
    color: rgba(255, 255, 255, 0.7);
  }

  .header-search {
    flex: 1 1 200px;
    min-width: 0;
  }

  @media screen and (max-width: 600px) {
    .header {
      flex-wrap: wrap;
      padding-left: 12px;
      padding-right: 12px;
    }

    .header__logo {
      width: 100%;
      justify-content: space-between;
      gap: 8px;
    }

    .header__tagline {
      font-size: 0.82rem;
      max-width: 180px;
      text-align: right;
    }

    .header__icons {
      width: 100%;
      gap: 0.45rem;
    }

    .header__icon {
      width: 34px;
      height: 34px;
      flex: 0 0 34px;
    }
  }

  @media screen and (max-width: 420px) {
    .header__tagline {
      display: none;
    }
  }

  /* Hide Shopify's cart notification */
  .cart-notification-wrapper,
  .cart-notification,
  #cart-notification {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    height: 0 !important;
    pointer-events: none !important;
  }

  .section-block {
    padding: 64px 0;
  }
  .section-block--navy {
    background: #10243D;
  }
  .section-block--teal {
    background: #2F8F83;
  }
  .section-block--lightblue {
    background: #888ec1;
  }

  .page-width {
    max-width: 1240px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }
</style>

<div class="header-wrapper">
  <header
    class="header"
    style="
      --header-padding-top-mobile: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
      --header-padding-bottom-mobile: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
      --header-padding-top-desktop: {{ section.settings.padding_top }}px;
      --header-padding-bottom-desktop: {{ section.settings.padding_bottom }}px;
    "
  >
    <!-- LOGO + TAGLINE -->
    <div class="header__logo">
      <a href="{{ routes.root_url }}" class="header__heading-link">
        {% if logo_img %}
          <img
            src="{{ logo_img | image_url: width: logo_w }}"
            width="{{ logo_w }}"
            height="{{ logo_w }}"
            alt="{{ section.settings.logo_alt | default: shop.name | escape }}"
            loading="eager"
            decoding="async"
          >
        {% else %}
          <span class="h2">{{ shop.name }}</span>
        {% endif %}
      </a>

      {%- if section.settings.tagline != blank -%}
        <span class="header__tagline" style="color: {{ section.settings.tagline_color | default: '#ffffff' }}">{{ section.settings.tagline | escape }}</span>
      {%- endif -%}
    </div>

    <!-- ICONS -->
    <div class="header__icons">
      <form role="search" class="header-search" action="{{ routes.search_url }}" method="get">
        <input type="search" name="q" placeholder="Search..." aria-label="Search">
        <input type="hidden" name="contact[Source_ID]" value="phoenix-flow-tracked">
      </form>

      {% if shop.customer_accounts_enabled %}
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          class="header__icon"
          aria-label="Account"
        >
          <svg width="24" height="24" fill="none">
            <path d="M16 17v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 5a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"
                  stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="header__icon" aria-label="Cart">
        <svg width="24" height="24" fill="none">
          <path d="M3 3h2l.4 2m0 0L7 13h8l2-8H5.4Z"
                stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="9" cy="17" r="1" stroke="#fff" stroke-width="2"/>
          <circle cx="15" cy="17" r="1" stroke="#fff" stroke-width="2"/>
        </svg>
      </a>

      <button
        type="button"
        class="header__icon header__icon--menu"
        id="menu-drawer-toggle"
        aria-label="Menu"
        aria-controls="menu-drawer"
        aria-expanded="false"
      >
        <svg width="24" height="24" fill="none">
          <rect x="4" y="7" width="16" height="2" rx="1" fill="#fff"/>
          <rect x="4" y="15" width="16" height="2" rx="1" fill="#fff"/>
        </svg>
      </button>
    </div>
  </header>
</div>

{% render 'menu-drawer', menu: section.settings.menu %}

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "text", "id": "logo_alt", "label": "Logo alt text", "default": "Site logo" },
    {
      "type": "range",
      "id": "logo_size",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Logo size",
      "default": 80
    },
    { "type": "header", "content": "Tagline" },
    { "type": "text", "id": "tagline", "label": "Tagline text", "default": "Reminding You to Use Your Imagination" },
    { "type": "color", "id": "tagline_color", "label": "Tagline color", "default": "#ffffff" },
    {
      "type": "range",
      "id": "tagline_size",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Tagline font size (px)",
      "default": 11
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "header_bg_color", "label": "Header background color", "default": "#26a69a" },
    { "type": "color", "id": "header_border_color", "label": "Header bottom border color", "default": "#26A69A" },
    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu", "label": "Navigation menu", "default": "main-menu" },
    {
      "type": "select",
      "id": "sticky_header_type",
      "label": "Sticky header",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "on-scroll-up", "label": "On scroll up" },
        { "value": "always", "label": "Always" }
      ],
      "default": "on-scroll-up"
    },
    { "type": "checkbox", "id": "show_line_separator", "label": "Show line separator", "default": false },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 24
    }
  ]
}
{% endschema %}
