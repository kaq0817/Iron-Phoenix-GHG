<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code | escape }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background | default: '#000000' | escape }}">

    {%- assign robots_directive = 'index, follow' -%}
    {%- if shop.password_enabled or template.name == 'search' or request.path contains '/checkout' -%}
      {%- assign robots_directive = 'noindex, nofollow' -%}
    {%- elsif template.name == 'article' and article -%}
      {%- if article.metafields.content.paywalled
        and article.metafields.content.paywalled.value
        or article.tags contains 'premium'
      -%}
        {%- assign robots_directive = 'noindex, noimageindex, noarchive, nosnippet' -%}
      {%- endif -%}
    {%- endif -%}
    <meta name="robots" content="{{ robots_directive | escape }}">
    <link rel="canonical" href="{{ canonical_url | escape }}">

    <meta
      name="description"
      content="Our Phoenix Rise (DBA Iron Phoenix GHG) offers made-to-order apparel, gifts, and lifestyle products with secure checkout and US-based customer support."
    >

    <title>
      {% if page_title %}
        {{ page_title | escape }}
      {% else %}
        {{ shop.name | escape }}
      {% endif %}
    </title>

    <link rel="sitemap" type="application/xml" href="{{ shop.url }}/sitemap.xml">

    {%- render 'cart-notification' -%}
    {%- render 'schema-protection' -%}
    {%- render 'meta-tags' -%}
    {%- render 'schema-structured-data' -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        sizes="32x32"
        href="{{ settings.favicon | image_url: width: 32, height: 32 | escape }}"
      >
    {%- endif -%}

    {%- comment -%} Preconnect to critical origins {%- endcomment -%}
    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com">
    {%- endunless -%}
    <link rel="preconnect" href="https://www.googletagmanager.com">
    <link rel="preconnect" href="https://www.google-analytics.com">
    <link rel="preconnect" href="https://cdn.shopify.com">

    {%- comment -%} Font preloading {%- endcomment -%}
    {%- capture body_json -%}{{ settings.type_body_font | json }}{%- endcapture -%}
    {%- capture head_json -%}{{ settings.type_header_font | json }}{%- endcapture -%}
    {%- if body_json contains '"family":' -%}
      {{ settings.type_body_font | font_url | preload_tag }}
    {%- endif -%}
    {%- if head_json contains '"family":' -%}
      {{ settings.type_header_font | font_url | preload_tag }}
    {%- endif -%}

    {% comment %} ⚡️ LCP OPTIMIZATION: Conditional Preload for Critical Images (product only) {% endcomment %}
    {%- liquid
      assign lcp_image = blank
      assign lcp_srcset = blank
      assign lcp_sizes = blank

      if template.name == 'product' and product and product.featured_media
        assign lcp_image = product.featured_media
        assign lcp_srcset = lcp_image | image_url: width: 600 | append: ' 600w, ' | append: lcp_image | image_url: width: 900 | append: ' 900w, ' | append: lcp_image | image_url: width: 1200 | append: ' 1200w'
        assign lcp_sizes = '(min-width: 750px) 50vw, 100vw'
      endif
    -%}
    {%- if lcp_image != blank -%}
      {{- lcp_image
        | image_url: width: 900
        | image_tag: preload: true, srcset: lcp_srcset, sizes: lcp_sizes, alt: lcp_image.alt, class: 'lcp-preload-hide', decoding: 'async'
      -}}
      <style>
        .lcp-preload-hide {
          display: none !important;
        }
      </style>
    {%- endif -%}

    {%- comment -%} Critical CSS {%- endcomment -%}
    {{ 'css-variables.css' | asset_url | stylesheet_tag }}
    {{ 'brand-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <style>
      :root {
        /* Global Palette — matches Global Store Theme in brand-tokens.css */
        --color-primary: #26A69A;
        --color-background-dark: #F7F7F5;
        --color-accent: #26A69A;
        --rgb-accent: 38, 166, 154;
        --color-secondary: #555555;
        --color-cta: #FFFF33;
        --color-text-light: #1F1F1F;
        --color-text-muted: #555555;
        --color-text-faded: #9CA3AF;
        --color-text-highlight: #374151;
        --color-border-subtle: #E5E7EB;
        --color-border-subtle-dark: #D1D5DB;
        --color-icon-default: #6B7280;

        /* Jewelry / Art Deco */
        --color-navy-deep: #0b1e3d;
        --color-royal-blue: #1a3a8f;
        --color-jewel-blue: #1e4db7;
        --color-ice-blue: #a8c4e0;
        --color-ivory: #f5f0e4;
        --color-pearl: #f8f5ef;
        --color-sapphire: #1845c8;
        --color-deco-gold: #c9a84c;

        /* Americana Front Porch */
        --color-americana-white: #f2ede4;
        --color-americana-navy: #1e3466;
        --color-americana-red: #9e2a2b;
        --color-americana-sky: #b8d4da;
        --color-americana-terra: #c1713a;
        --color-americana-check: #2d4a7a;
        --color-americana-wheat: #d9c49a;

        /* Header */
        --color-header-gradient-start: #ffffff;
        --color-header-gradient-end: #f9f7f4;
        --color-search-bg: rgba(26, 26, 26, 0.06);
        --color-search-placeholder: #9ca3af;
      }

      html { box-sizing: border-box; }
      *, *::before, *::after { box-sizing: inherit; }
      html { font-size: calc(var(--font-body-scale) * 62.5%); }
      body {
        display: grid;
        grid-template-rows: auto auto 1fr auto;
        min-height: 100%;
        margin: 0;
        background-color: var(--color-bg, #F7F7F5);
        color: var(--color-main-text, #1F1F1F);
        font-family: var(--font-body-family);
        font-size: 1.5rem;
      }
      @media (min-width: 750px) {
        body { font-size: 1.6rem; }
      }

      body.template-index #MainContent {
        position: relative;
        background: var(--color-bg, #F7F7F5);
      }

      /* Kill legacy gaming scanline/rail overlays from old skins */
      body::before,
      body::after {
        content: none !important;
        background: none !important;
      }

      body.template-index #MainContent::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        border: 0;
        box-shadow: none;
      }

      body.template-index #MainContent .shopify-section {
        position: relative;
      }

      body.template-index #MainContent .shopify-section + .shopify-section {
        border-top: 0;
      }

      body.template-index #MainContent [id^='LevelUpHero-'] .levelup-hero__bg {
        background: linear-gradient(180deg, rgba(7, 12, 20, 0.96) 0%, rgba(5, 9, 16, 0.94) 100%);
      }

      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}
      img { max-width: 100%; height: auto; object-fit: cover; object-position: center; loading: lazy; decoding: async; }
    </style>

    {{ content_for_header }}

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Our Phoenix Rise",
        "alternateName": "Iron Phoenix GHG",
        "legalName": "Go Hard Gaming Discord LLC",
        "url": "https://ourphoenixrise.com",
        "description": "Our Phoenix Rise is operated by Go Hard Gaming Discord LLC (DBA Iron Phoenix GHG).",
        "sameAs": [
          "https://facebook.com/GohardgamingIronPhoenix",
          "https://twitter.com/SSgohardgaming",
          "https://youtube.com/@shadowseekerOG",
          "https://tiktok.com/@gohardgamingdiscord"
        ],
        "contactPoint": [
          {
            "@type": "ContactPoint",
            "contactType": "Customer Support",
            "email": "Helpcenter@ourphoenixrise.com",
            "telephone": "+1-518-415-8496",
            "url": "https://ourphoenixrise.com/pages/contact",
            "availableLanguage": ["English"],
            "areaServed": "US"
          }
        ]
      }
    </script>
</head>

  <body class="template-{{ template.name | escape }} gradient{% if settings.animations_hover_elements != 'none' %} animate--hover-{{ settings.animations_hover_elements | escape }}{% endif %}">
    <script>
      document.documentElement.classList.replace('no-js', 'js');
    </script>

    {%- unless template.name == 'password' -%}
      {%- if settings.cart_type == 'drawer' -%}{% section 'cart-drawer' %}{%- endif -%}
      {% section 'header' %}
    {%- endunless -%}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- unless template.name == 'password' -%}
      {% section 'footer' %}
    {%- endunless -%}

    {%- render 'product-media-modal' -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t | escape }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t | escape }}</li>
    </ul>

    {%- render 'bot-protection' -%}

    {%- comment -%} Single JavaScript file - global.js functionality merged into theme.js {%- endcomment -%}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {%- comment -%} ---- Google gtag.js only (no GTM; no duplicates) ---- {%- endcomment -%}
    {%- assign ga4_id = settings.ga4_id | strip | default: 'G-V6ZP7KWRZN' -%}
    {%- assign gtag_id = settings.google_tag_id | strip | default: 'GT-552Q5J6X' -%}

    {%- assign ga4_prefix = ga4_id | slice: 0, 2 -%}
    {%- assign gtag_prefix = gtag_id | slice: 0, 3 -%}
    {%- assign has_ga4 = false -%}
    {%- if ga4_id != blank and ga4_prefix == 'G-' -%}
      {%- assign has_ga4 = true -%}
    {%- endif -%}

    {%- assign has_gtag = false -%}
    {%- if gtag_id != blank and gtag_prefix == 'GT-' -%}
      {%- assign has_gtag = true -%}
    {%- endif -%}

    {%- assign primary_id = '' -%}
    {%- if has_ga4 -%}
      {%- assign primary_id = ga4_id -%}
    {%- elsif has_gtag -%}
      {%- assign primary_id = gtag_id -%}
    {%- endif -%}

    {%- if primary_id != '' -%}
      <script async src="https://www.googletagmanager.com/gtag/js?id={{ primary_id | escape }}"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        gtag('js', new Date());
        {% if has_ga4 %}gtag('config', '{{ ga4_id  | escape }}');{% endif %}
        {% if has_gtag %}gtag('config', '{{ gtag_id | escape }}');{% endif %}
      </script>
    {%- else -%}
      <script>
        console.warn('gtag not loaded: no valid GA4 (G-*) or Google Tag (GT-*) ID.');
      </script>
    {%- endif -%}

    {%- render 'feature-scripts' -%}

    <script>
      // Defer non-critical scripts (placeholder)
      window.addEventListener('load', function () {
        // load chat widgets or other non-critical scripts here
      });
    </script>
  </body>
</html>
