<!doctype html>
{%- liquid
  assign host_name = request.host | downcase
  assign host_parts = host_name | split: '.'
  assign host_subdomain = host_parts.first
  assign brand_from_host = ''

  case host_subdomain
    when 'sports', 'active'
      assign brand_from_host = 'sports'
    when 'outdoors', 'outdoor', 'camping'
      assign brand_from_host = 'outdoors'
    when 'home', 'decor', 'homedecor'
      assign brand_from_host = 'home'
    when 'americana'
      assign brand_from_host = 'americana'
    when 'gaming', 'gamer', 'gamingfamily'
      assign brand_from_host = 'family'
    when 'jewelry', 'jewellery'
      assign brand_from_host = 'jewelry'
    when 'family', 'children', 'child', 'kids', 'kid'
      assign brand_from_host = 'family'
  endcase
-%}
<html class="no-js" lang="{{ request.locale.iso_code | escape }}"{% if brand_from_host != '' %} data-brand="{{ brand_from_host }}"{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background | default: '#000000' | escape }}">

    {%- assign robots_directive = 'index, follow' -%}
    {%- if shop.password_enabled or template.name == 'search' or request.path contains '/checkout' -%}
      {%- assign robots_directive = 'noindex, nofollow' -%}
    {%- elsif template.name == 'article' and article -%}
      {%- if article.metafields.content.paywalled
        and article.metafields.content.paywalled.value
        or article.tags contains 'premium'
      -%}
        {%- assign robots_directive = 'noindex, noimageindex, noarchive, nosnippet' -%}
      {%- endif -%}
    {%- endif -%}
    {%- if request.path contains 'short-trade-description' -%}
      <meta name="robots" content="noindex, nofollow">
    {%- else -%}
      <meta name="robots" content="{{ robots_directive | escape }}">
    {%- endif -%}
    <link rel="canonical" href="https://ironphoenix.store{{ request.path }}">

    <meta
      name="description"
      content="Iron Phoenix GHG — lifestyle products, apparel, and gifts for parents who work hard and come home ready to relax. Secure checkout, US-based support."
    >

    <title>
      {% if page_title %}
        {{ page_title | escape }}
      {% else %}
        {{ shop.name | escape }}
      {% endif %}
    </title>

    {%- render 'cart-notification' -%}
    {%- render 'schema-protection' -%}
    {%- render 'meta-tags' -%}
    {%- render 'schema-structured-data' -%}

    {%- comment -%} Preconnect to critical origins {%- endcomment -%}
    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com">
    {%- endunless -%}
    <link rel="preconnect" href="https://www.googletagmanager.com">
    <link rel="preconnect" href="https://www.google-analytics.com">
    <link rel="preconnect" href="https://cdn.shopify.com">

    {%- comment -%} Font preloading {%- endcomment -%}
    {%- capture body_json -%}{{ settings.type_body_font | json }}{%- endcapture -%}
    {%- capture head_json -%}{{ settings.type_header_font | json }}{%- endcapture -%}
    {%- if body_json contains '"family":' -%}
      {{ settings.type_body_font | font_url | preload_tag }}
    {%- endif -%}
    {%- if head_json contains '"family":' -%}
      {{ settings.type_header_font | font_url | preload_tag }}
    {%- endif -%}

    {%- comment -%} ⚡️ LCP OPTIMIZATION: Preload link for critical above-the-fold image {%- endcomment -%}
    {%- comment -%} theme-check-disable: using manual preload link intentionally — image_tag:preload renders an <img> in <head> which is invalid HTML {%- endcomment -%}
    {%- if template.name == 'product' and product and product.featured_media -%}
      {%- assign lcp_img = product.featured_media -%}
      {%- assign lcp_srcset = lcp_img | image_url: width: 600 | append: ' 600w, ' | append: lcp_img | image_url: width: 900 | append: ' 900w, ' | append: lcp_img | image_url: width: 1200 | append: ' 1200w' -%}
      {% comment %}theme-check-disable RemoteAsset{% endcomment %}
      <link rel="preload" as="image"
        href="{{ lcp_img | image_url: width: 900 }}"
        imagesrcset="{{ lcp_srcset }}"
        imagesizes="(min-width: 750px) 50vw, 100vw"
      >
      {% comment %}theme-check-enable RemoteAsset{% endcomment %}
    {%- endif -%}

    {%- comment -%} Critical CSS {%- endcomment -%}
    {{ 'css-variables.css' | asset_url | stylesheet_tag }}
    {{ 'brand-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'product-modal.css' | asset_url | stylesheet_tag }}

    <style>
      :root {
        /* Global Palette — matches Iron Phoenix GHG default in brand-tokens.css */
        --color-primary: #C9A84C;
        --color-background-dark: #F9F6F1;
        --color-accent: #C9A84C;
        --rgb-accent: 201, 168, 76;
        --color-secondary: #5C4E44;
        --color-cta: #6B2737;
        --color-text-light: #1A1310;
        --color-text-muted: #5C4E44;
        --color-text-faded: #A8998E;
        --color-text-highlight: #3D2B22;
        --color-border-subtle: #EAE0D5;
        --color-border-subtle-dark: #D8CCB8;
        --color-icon-default: #8B7B72;

        /* Jewelry / Art Deco */
        --color-navy-deep: #0b1e3d;
        --color-royal-blue: #1a3a8f;
        --color-jewel-blue: #1e4db7;
        --color-ice-blue: #a8c4e0;
        --color-ivory: #f0f9f8;
        --color-pearl: #f8f5ef;
        --color-sapphire: #1845c8;
        --color-deco-gold: #26a69a;

        /* Americana Front Porch */
        --color-americana-white: #f2ede4;
        --color-americana-navy: #1e3466;
        --color-americana-red: #9e2a2b;
        --color-americana-sky: #b8d4da;
        --color-americana-terra: #c1713a;
        --color-americana-check: #2d4a7a;
        --color-americana-wheat: #d9c49a;

        /* Header */
        --color-header-gradient-start: #ffffff;
        --color-header-gradient-end: #f9f7f4;
        --color-search-bg: rgba(26, 26, 26, 0.06);
        --color-search-placeholder: #9ca3af;
      }

      html { box-sizing: border-box; }
      *, *::before, *::after { box-sizing: inherit; }
      html { font-size: calc(var(--font-body-scale) * 62.5%); }
      body {
        display: grid;
        grid-template-rows: auto auto 1fr auto;
        min-height: 100%;
        margin: 0;
        background-color: var(--color-bg, #F7F7F5);
        color: var(--color-main-text, #1F1F1F);
        font-family: var(--font-body-family);
        font-size: 1.5rem;
      }
      @media (min-width: 750px) {
        body { font-size: 1.6rem; }
      }

      body.template-index #MainContent {
        position: relative;
        background: var(--color-bg, #F7F7F5);
      }

      body.template-index #MainContent .shopify-section {
        position: relative;
      }

      body.template-index #MainContent .shopify-section + .shopify-section {
        border-top: 0;
      }

      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}
      img { max-width: 100%; height: auto; object-fit: cover; object-position: center; }
    </style>

    {{ content_for_header }}

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Iron Phoenix GHG",
        "alternateName": "Iron Phoenix GHG",
        "legalName": "Go Hard Gaming Discord LLC",
        "url": "https://ironphoenix.store",
        "description": "Iron Phoenix GHG is operated by Go Hard Gaming Discord LLC.",
        "contactPoint": [
          {
            "@type": "ContactPoint",
            "contactType": "Customer Support",
            "email": "support@ironphoenix.store",
            "telephone": "+1-518-415-8496",
            "url": "https://ironphoenix.store/pages/contact",
            "availableLanguage": ["English"],
            "areaServed": "US"
          }
        ]
      }
    </script>
</head>

  <body class="template-{{ template.name | escape }} gradient{% if settings.animations_hover_elements != 'none' %} animate--hover-{{ settings.animations_hover_elements | escape }}{% endif %}">
    <script>
      document.documentElement.classList.replace('no-js', 'js');
    </script>

    {%- unless template.name == 'password' -%}
      {%- if settings.cart_type == 'drawer' -%}{% section 'cart-drawer' %}{%- endif -%}
      {% section 'header' %}
    {%- endunless -%}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- unless template.name == 'password' -%}
      {% section 'footer' %}
    {%- endunless -%}

    {%- render 'product-media-modal' -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t | escape }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t | escape }}</li>
    </ul>

    {%- render 'bot-protection' -%}

    {%- comment -%} Single JavaScript file - global.js functionality merged into theme.js {%- endcomment -%}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>


    {%- comment -%} ---- Google gtag.js only (no GTM; no duplicates) ---- {%- endcomment -%}
    {%- assign ga4_id = settings.ga4_id | strip | default: 'G-V6ZP7KWRZN' -%}
    {%- assign gtag_id = settings.google_tag_id | strip | default: 'GT-552Q5J6X' -%}

    {%- assign ga4_prefix = ga4_id | slice: 0, 2 -%}
    {%- assign gtag_prefix = gtag_id | slice: 0, 3 -%}
    {%- assign has_ga4 = false -%}
    {%- if ga4_id != blank and ga4_prefix == 'G-' -%}
      {%- assign has_ga4 = true -%}
    {%- endif -%}

    {%- assign has_gtag = false -%}
    {%- if gtag_id != blank and gtag_prefix == 'GT-' -%}
      {%- assign has_gtag = true -%}
    {%- endif -%}

    {%- assign primary_id = '' -%}
    {%- if has_ga4 -%}
      {%- assign primary_id = ga4_id -%}
    {%- elsif has_gtag -%}
      {%- assign primary_id = gtag_id -%}
    {%- endif -%}

    {%- if primary_id != '' -%}
      <script async src="https://www.googletagmanager.com/gtag/js?id={{ primary_id | escape }}"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        gtag('js', new Date());
        {% if has_ga4 %}gtag('config', '{{ ga4_id  | escape }}');{% endif %}
        {% if has_gtag %}gtag('config', '{{ gtag_id | escape }}');{% endif %}
      </script>
    {%- else -%}
      <script>
        console.warn('gtag not loaded: no valid GA4 (G-*) or Google Tag (GT-*) ID.');
      </script>
    {%- endif -%}

    {%- render 'feature-scripts' -%}

    <script>
      // Defer non-critical scripts (placeholder)
      window.addEventListener('load', function () {
        // load chat widgets or other non-critical scripts here
      });
    </script>
  </body>
</html>
