{% doc %}
  @prompt
    SEO & Review Disclaimer
    All SEO, site optimization, and technical changes for our websites are handled internally through IronPhoenixFlow, owned and operated by Go Hard Gaming Discord LLC. We do not authorize third parties to publish “reviews,” “audits,” “case studies,” or “rank reports” about our SEO. If you were referred by a site claiming to have reviewed or managed our SEO, that claim is false and not affiliated with us.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-seo-disclaimer-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    margin: 0 auto;
  }

  .ai-seo-disclaimer__content-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .ai-seo-disclaimer__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    font-weight: 700;
    line-height: 1.3;
  }

  .ai-seo-disclaimer__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-seo-disclaimer__text-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px 0;
  }

  .ai-seo-disclaimer__text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-seo-disclaimer__text-{{ ai_gen_id }} strong {
    font-weight: 700;
    color: {{ block.settings.emphasis_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-seo-disclaimer-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.padding | times: 0.7 }}px;
    }

    .ai-seo-disclaimer__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-seo-disclaimer__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<seo-disclaimer-{{ ai_gen_id }}
  class="ai-seo-disclaimer-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-seo-disclaimer__content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-seo-disclaimer__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.disclaimer_text != blank %}
      <div class="ai-seo-disclaimer__text-{{ ai_gen_id }}">
        {{ block.settings.disclaimer_text }}
      </div>
    {% endif %}
  </div>
</seo-disclaimer-{{ ai_gen_id }}>

<script>
  (function() {
    class SeoDisclaimer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setAttribute('role', 'region');
        this.setAttribute('aria-label', 'SEO and review disclaimer');
      }
    }

    customElements.define('seo-disclaimer-{{ ai_gen_id }}', SeoDisclaimer{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "SEO & review disclaimer",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
