{%- comment -%}
/snippets/policy-links.liquid
Portable policy links (no hardcoded domain/handles).
Only render links that exist in the store’s policy settings.
{%- endcomment -%}

<ul class="policy-links" role="list">
  {%- if shop.policies.privacy -%}
    <li><a href="{{ shop.policies.privacy.url }}">Privacy Policy</a></li>
  {%- endif -%}

  {%- if shop.policies.terms_of_service -%}
    <li><a href="{{ shop.policies.terms_of_service.url }}">Terms of Service</a></li>
  {%- endif -%}

  {%- if shop.policies.refund -%}
    <li><a href="{{ shop.policies.refund.url }}">Return &amp; Refund Policy</a></li>
  {%- endif -%}

  {%- if shop.policies.shipping -%}
    <li><a href="{{ shop.policies.shipping.url }}">Shipping Information</a></li>
  {%- endif -%}
</ul>
