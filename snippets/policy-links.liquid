{%- comment -%}
  /snippets/policy-links.liquid
  Portable, accessible policy links.
  Renders only if the policy exists in **Settings → Policies**.
  Renders direct anchor tags to be compatible with flexbox parent.
{%- endcomment -%}

{%- if shop.policies.privacy_policy -%}
  <a href="{{ shop.policies.privacy_policy.url }}" class="footer__legal-link">
    {{ shop.policies.privacy_policy.title | escape }}
  </a>
{%- endif -%}

{%- if shop.policies.terms_of_service -%}
  <a href="{{ shop.policies.terms_of_service.url }}" class="footer__legal-link">
    {{ shop.policies.terms_of_service.title | escape }}
  </a>
{%- endif -%}

{%- if shop.policies.refund_policy -%}
  <a href="{{ shop.policies.refund_policy.url }}" class="footer__legal-link">
    {{ shop.policies.refund_policy.title | escape }}
  </a>
{%- endif -%}

{%- if shop.policies.shipping_policy -%}
  <a href="{{ shop.policies.shipping_policy.url }}" class="footer__legal-link">
    {{ shop.policies.shipping_policy.title | escape }}
  </a>
{%- endif -%}

{%- comment -%}
  Optional: Add other common policies if needed, e.g., legal notice, imprint.
  Check shop.policies for all available policies.
{%- endcomment -%}
