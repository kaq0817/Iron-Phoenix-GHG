{%- comment -%}
  rating-badge.liquid — shows rating from metafield reviews.rating
{%- endcomment -%}
{%- assign r = product.metafields.reviews.rating.value -%}
{%- if r -%}
  {%- assign max = r.scale_max | default: 5 -%}
  <div
    class="rating"
    role="img"
    aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: r.rating, rating_max: max }}"
  >
    <span
      aria-hidden="true"
      class="rating-star"
      style="--rating: {{ r.rating | round: 1 }}; --rating-max: {{ max }};"
    ></span>
  </div>
  <p class="rating-text caption">
    <span aria-hidden="true">{{ r.rating }} / {{ max }}</span>
  </p>
  <p class="rating-count caption">
    <span aria-hidden="true">({{ r.rating_count }})</span>
    <span class="visually-hidden">
      {{ r.rating_count }} {{ 'accessibility.total_reviews' | t }}
    </span>
  </p>
{%- endif -%}
