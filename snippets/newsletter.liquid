{%- comment -%} snippets/newsletter.liquid — standalone signup {%- endcomment -%}
<div class="newsletter-form-wrapper">
  {% form 'customer', class: 'newsletter-form' %}
    <input type="hidden" name="contact[tags]" value="newsletter-tiered-sale">

    <div class="field">
      <input
        id="NewsletterForm--snippet"
        type="email"
        name="contact[email]"
        class="field__input"
        value="{{ form.email }}"
        aria-required="true"
        autocorrect="off" autocapitalize="off" autocomplete="email"
        {% if form.errors %}autofocus aria-invalid="true" aria-describedby="Newsletter-error--snippet"{% endif %}
        placeholder="{{ 'newsletter.label' | t | default: 'Email' }}"
        required
      >
      <label class="field__label" for="NewsletterForm--snippet">
        {{ 'newsletter.label' | t | default: 'Email' }}
      </label>
      <button type="submit" class="newsletter-form__button field__button" name="commit" aria-label="{{ 'newsletter.button_label' | t | default: 'Subscribe' }}">
        <span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
      </button>
    </div>

    {%- if form.errors -%}
      <small class="newsletter-form__message form__message" id="Newsletter-error--snippet">
        <span class="svg-wrapper">{{ 'icon-error.svg' | inline_asset_content }}</span>
        {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
      </small>
    {%- endif -%}

    <fieldset class="newsletter-interests" aria-label="Interests" style="margin-top:.75rem;display:grid;gap:.5rem">
      <legend class="visually-hidden">Interests</legend>
      <label class="checkbox"><input type="checkbox" name="contact[tags]" value="Product Updates"><span>Product Updates</span></label>
      <label class="checkbox"><input type="checkbox" name="contact[tags]" value="Blog News"><span>Blog News</span></label>
    </fieldset>

    {%- if form.posted_successfully? -%}
      <p class="newsletter-form__message newsletter-form__message--success form__message">
        {{ 'newsletter.success' | t | default: 'Thanks for subscribing' }}
      </p>
    {%- endif -%}
  {% endform %}
</div>
