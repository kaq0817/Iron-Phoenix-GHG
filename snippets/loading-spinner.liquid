{%- comment -%}
  Loading Spinner Component
  Accessible animated loader for async events.
  Usage: {% render 'loading-spinner' %}
{%- endcomment -%}

<div class="loading-spinner" aria-hidden="true" role="presentation">
  <svg class="spinner" viewBox="0 0 50 50">
    <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
  </svg>
</div>

{{ 'loading-spinner.css' | asset_url | stylesheet_tag }}
