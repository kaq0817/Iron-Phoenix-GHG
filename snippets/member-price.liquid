{%- comment -%} /snippets/member-price.liquid {%- endcomment -%}
{% if settings.enable_membership and settings.vip_show_member_price %}
  {% assign p = product %}
  {% assign v = p.selected_or_first_available_variant | default: p.variants.first %}
  {% if v %}
    {% assign base_price = v.price | default: 0 %}

    {%- comment -%} Determine membership {%- endcomment -%}
    {% assign is_member = false %}

    {% if customer %}
      {%- comment -%} Build a trimmed allowlist from settings {%- endcomment -%}
      {% assign allowed_raw = settings.membership_allowed_tags | default: 'Member,VIP' %}
      {% assign allowed_arr = allowed_raw | split: ',' %}
      {% assign cleaned_allowlist = '' %}
      {% for atag in allowed_arr %}
        {% assign trimmed = atag | strip %}
        {% assign cleaned_allowlist = cleaned_allowlist | append: trimmed | append: '|' %}
      {% endfor %}
      {% assign cleaned_allowlist = cleaned_allowlist | split: '|' %}

      {%- comment -%} Match any allowed tag {%- endcomment -%}
      {% for t in customer.tags %}
        {% assign cleaned_tag = t | strip %}
        {% if cleaned_allowlist contains cleaned_tag %}
          {% assign is_member = true %}
          {% break %}
        {% endif %}
      {% endfor %}

      {%- comment -%} Metafield flags (prefer boolean, then date) {%- endcomment -%}
      {% if is_member == false and customer.metafields.membership.active and customer.metafields.membership.active.value == true %}
        {% assign is_member = true %}
      {% endif %}

      {% if is_member == false and customer.metafields.membership.expires_on and customer.metafields.membership.expires_on.value %}
        {% assign today = 'now' | date: '%Y-%m-%d' %}
        {% assign exp = customer.metafields.membership.expires_on.value | date: '%Y-%m-%d' %}
        {% if exp >= today %}
          {% assign is_member = true %}
        {% endif %}
      {% endif %}
    {% endif %}

    {% if is_member %}
      {% assign member_price = blank %}
      {% assign member_pct = blank %} {# optional: expose percent for JS #}

      {%- comment -%} Explicit member price metafield dominates {%- endcomment -%}
      {% if p.metafields.custom.member_price and p.metafields.custom.member_price.value != blank %}
        {% assign member_price = p.metafields.custom.member_price.value | plus: 0 %}

      {%- comment -%} Else percent metafield {%- endcomment -%}
      {% elsif p.metafields.custom.member_discount_percent and p.metafields.custom.member_discount_percent.value != blank %}
        {% assign pct = p.metafields.custom.member_discount_percent.value | plus: 0 %}
        {% assign member_pct = pct %}
        {% assign one_hundred = 100 %}
        {% assign factor = one_hundred | minus: pct %}
        {%- comment -%} math in cents with rounding {%- endcomment -%}
        {% assign raw_cents = v.price | times: factor %}
        {% assign member_price = raw_cents | divided_by: 100 | round %}

      {%- comment -%} Else theme default percent {%- endcomment -%}
      {% else %}
        {% assign pct = settings.vip_discount_percent | default: 0 | plus: 0 %}
        {% if pct > 0 %}
          {% assign member_pct = pct %}
          {% assign one_hundred = 100 %}
          {% assign factor = one_hundred | minus: pct %}
          {% assign raw_cents = v.price | times: factor %}
          {% assign member_price = raw_cents | divided_by: 100 | round %}
        {% endif %}
      {% endif %}

      {% if member_price %}
        <div class="member-price" style="margin:.25rem 0 0">
          <span class="member-price__label" style="font-weight:600">
            {{ settings.vip_badge_text | default: 'VIP' }} price
          </span>
          {%- comment -%}
            data-vip-price and data-vip-compare act as OPTIONAL dynamic hooks.
            If you wire them in JS, you can recompute on variant change.
          {%- endcomment -%}
          <span class="member-price__value" data-vip-price style="margin-left:.5rem">
            {{ member_price | money }}
          </span>
          <s class="member-price__compare" data-vip-compare style="margin-left:.5rem;opacity:.7">
            {{ base_price | money }}
          </s>

          {%- comment -%} Optional: expose percent for JS consumers (hidden) {%- endcomment -%}
          {% if member_pct %}
            <span class="visually-hidden" data-vip-percent="{{ member_pct | escape }}"></span>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}
  {% endif %}
{% endif %}
