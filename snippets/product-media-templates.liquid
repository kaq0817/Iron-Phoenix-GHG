{%- comment -%}
Renders <template> blocks keyed by media.id for modal injection.
Works with: snippets/optimized-image.liquid and global IPXMediaModal JS.
{%- endcomment -%}

{%- if product.media and product.media.size > 0 -%}
  <div class="ip-media-templates" hidden>
    {%- for m in product.media -%}
      <template data-ip-media-template id="ip-media-{{ m.id }}">
        {%- case m.media_type -%}
          {%- when 'image' -%}
            <figure class="ip-modal__figure">
            {% render 'optimized-image',
               image: m,
               width_override: 1600,
               sizes: '(max-width: 749px) 100vw, (max-width: 989px) 90vw, 80vw',
               loading: 'eager',
               fetchpriority: 'high',
               class: 'ip-modal__img',
               alt: product.title
             %}
              {%- if m.alt != blank -%}
                <figcaption class="ip-modal__caption">{{ m.alt | escape }}</figcaption>
              {%- endif -%}
            </figure>

          {%- when 'video' -%}
            <div class="ip-modal__video">
              {{ m | video_tag: controls: true, autoplay: false, loop: false, muted: false, class: 'ip-modal__video-el' }}
            </div>

          {%- when 'external_video' -%}
            <div class="ip-modal__video">
              {{ m | external_video_tag: class: 'ip-modal__video-el' }}
            </div>

          {%- when 'model' -%}
            <div class="ip-modal__model">
              {{ m | model_viewer_tag: reveal: 'interaction', ar: true, camera_controls: true, class: 'ip-modal__model-el' }}
            </div>

          {%- else -%}
            <div class="ip-modal__unsupported">
              {{ 'products.product.media.open_media' | t: index: forloop.index | default: 'Media not supported in modal.' }}
            </div>
        {%- endcase -%}
      </template>
    {%- endfor -%}
  </div>
{%- endif -%}
