{%- comment -%}
/snippets/inventory-guard.liquid
Purpose: Provide numeric stock + availability for UI & JSON-LD without exposing zero.
Policy: POD vendors are made-to-order; never show qty < 1 because of app/blank signals.
Output: No HTML here. Escape when rendering.

Usage:
  {% render 'inventory-guard', product: product %}
  <!-- UI (escaped) -->
  <span class="stock">{{ inv_safe_quantity | escape }} in stock</span>
  <!-- JSON-LD -->
  "availability": "http://schema.org/{{ inv_availability }}",
  "inventoryLevel": { "@type": "QuantitativeValue", "value": {{ inv_safe_quantity }} }
{%- endcomment -%}

{%- assign ig_product = product -%}
{%- if ig_product == nil and product and product.handle -%}
  {%- assign ig_product = all_products[product.handle] -%}
{%- endif -%}

{%- comment -%} POD vendor list (NO CJ) {%- endcomment -%}
{%- assign pod_vendor_list = 'Printify,Printful,AnywherePod,CustomCat,Gooten,Teespring,Redbubble'
  | split: ',' | map: 'strip' -%}
{%- assign vendor_clean = ig_product.vendor | strip -%}
{%- assign is_pod_vendor = false -%}
{%- for v_name in pod_vendor_list -%}
  {%- if vendor_clean == v_name -%}{%- assign is_pod_vendor = true -%}{%- break -%}{%- endif -%}
{%- endfor -%}

{%- assign v = ig_product.selected_or_first_available_variant -%}
{%- assign v_is_available = v and v.available -%}

{%- comment -%} Base quantity from platform {%- endcomment -%}
{%- assign base_qty = 0 -%}
{%- if v and v.inventory_quantity != blank -%}
  {%- assign base_qty = v.inventory_quantity -%}
{%- endif -%}

{%- comment -%} Normalize quantity: avoid 0 for UI/SEO. {%- endcomment -%}
{%- assign inv_safe_quantity = base_qty -%}
{%- if inv_safe_quantity == blank -%}{%- assign inv_safe_quantity = 0 -%}{%- endif -%}
{%- if inv_safe_quantity <= 0 -%}
  {%- if is_pod_vendor -%}
    {%- assign inv_safe_quantity = 999 -%}
  {%- else -%}
    {%- assign inv_safe_quantity = 1 -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%} Availability for schema.org Offer {%- endcomment -%}
{%- assign inv_availability = 'InStock' -%}
{%- if v_is_available == false -%}
  {%- assign inv_availability = 'OutOfStock' -%}
{%- endif -%}
{%- if is_pod_vendor and inv_availability == 'OutOfStock' -%}
  {%- comment -%} POD respects explicit disable; if truly unavailable, leave as OutOfStock {%- endcomment -%}
  {%- if v and v.available == false -%}
    {%- assign inv_availability = 'OutOfStock' -%}
  {%- else -%}
    {%- assign inv_availability = 'InStock' -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%}
Theme Check usage sink (non-rendering) so assigns count as used.
{%- endcomment -%}
{%- if 0 -%}{{ inv_safe_quantity }}{{ inv_availability }}{%- endif -%}
