{% comment %} Collection Card Component — Iron Phoenix GHG {% endcomment %}

<a href="{{ card_collection.url }}" class="collection-card">
  <div class="collection-card__media">
    {% if card_collection.image %}
      {{ card_collection.image | image_url: width: 800 | image_tag: widths: '400,600,800', sizes: '100vw', class: 'collection-card__image', alt: card_collection.title | escape }}
    {% else %}
      {{ 'collection-1' | placeholder_svg_tag }}
    {% endif %}
  </div>

  <div class="collection-card__info">
    <h2 class="collection-card__title">{{ card_collection.title | escape }}</h2>
    <p class="collection-card__count">
      {{ card_collection.all_products_count }} product{{ 's' | pluralize: card_collection.all_products_count }}
    </p>
  </div>
</a>
