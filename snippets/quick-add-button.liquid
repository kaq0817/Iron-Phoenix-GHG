{%- comment -%}
  snippets/quick-add-button.liquid
  - Uses selected_or_first_available_variant (safer than .first)
  - Disables when no purchasable variant exists
  - Accessible labels + simple loading state hook
  - Works on product cards or PDP
{%- endcomment -%}

{%- assign v = product.selected_or_first_available_variant -%}
{%- assign can_add = false -%}
{%- if v and v.available -%}
  {%- assign can_add = true -%}
{%- endif -%}

{%- if can_add -%}
  <form method="post"
        action="{{ routes.cart_add_url }}"
        class="quick-add-form"
        data-quick-add
        novalidate>
    <input type="hidden" name="id" value="{{ v.id }}">
    <input type="hidden" name="quantity" value="1">

    <button type="submit"
            class="quick-add-button"
            name="add"
            aria-label="{{ 'products.product.add_to_cart' | t }}: {{ product.title | escape }}"
            data-quick-add-btn
            >
      <span class="quick-add-button__text">{{ 'products.product.add_to_cart' | t }}</span>
      <span class="quick-add-button__spinner" hidden aria-hidden="true">●●●</span>
    </button>
  </form>
{%- else -%}
  {%- comment -%}
    No available variants: keep the UI useful.
    Link to the product so shoppers can pick options or see restock info.
  {%- endcomment -%}
  <a class="quick-add-button quick-add-button--disabled"
     href="{{ product.url }}"
     aria-disabled="true">
    {{ 'products.product.view_full_details' | t | default: 'View full details' }}
  </a>
{%- endif -%}

{%- comment -%}
  Minimal CSS hooks (optional): add to your CSS if you like

  .quick-add-button {
    display:inline-flex; align-items:center; gap:.5rem;
    padding:.7rem 1.2rem; border-radius: var(--buttons-radius, 6px);
  }
  .quick-add-button[aria-busy="true"] .quick-add-button__text { opacity:.6 }
  .quick-add-button__spinner[hidden] { display:none }
{%- endcomment -%}

{%- comment -%}
  Optional JS hook (your global.js can listen to submit to show loading):
  document.addEventListener('submit', (e) => {
    const f = e.target.closest('[data-quick-add]');
    if (!f) return;
    const btn = f.querySelector('[data-quick-add-btn]');
    const spin = f.querySelector('.quick-add-button__spinner');
    if (btn) btn.setAttribute('aria-busy','true');
    if (spin) spin.hidden = false;
  });
{%- endcomment -%}
