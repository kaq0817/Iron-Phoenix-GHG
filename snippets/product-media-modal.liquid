{%- comment -%}
  snippets/product-media-modal.liquid
  Accessible modal for zooming product images/videos
  Usage: render this near the end of sections/main-product.liquid (once)
{%- endcomment -%}

<div
  id="ProductMediaModal"
  class="ip-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ip-modal-title"
  hidden
>
  <div class="ip-modal__overlay" data-ip-modal-close></div>

  <div class="ip-modal__panel" role="document">
    <header class="ip-modal__header">
      <h2 id="ip-modal-title" class="ip-modal__title">{{ product.title | escape }}</h2>
      <button
        type="button"
        class="ip-modal__close"
        aria-label="{{ 'general.share.close' | t | default: 'Close' }}"
        data-ip-modal-close
      >
        &times;
      </button>
    </header>

    <div class="ip-modal__body" id="ip-modal-body" tabindex="-1" data-ip-modal-body>
      {%- comment -%} Content injected from templates at runtime {%- endcomment -%}
    </div>
  </div>
</div>
