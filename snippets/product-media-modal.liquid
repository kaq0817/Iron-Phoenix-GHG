{%- comment -%}
Accessible modal for zooming product media.
Used by global.js click handler and product-modal.js controller.
{%- endcomment -%}
<div
  id="ProductMediaModal"
  class="ip-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ip-modal-title"
  hidden
>
  <div class="ip-modal__overlay" data-ip-modal-close></div>

  <div class="ip-modal__panel" role="document">
    <header class="ip-modal__header">
      <h2 id="ip-modal-title" class="ip-modal__title">{{ product.title | default: shop.name | escape }}</h2>
      <button
        type="button"
        class="ip-modal__close"
        aria-label="{{ 'general.share.close' | t | default: 'Close' | escape }}"
        data-ip-modal-close
      >&times;</button>
    </header>

    <div class="ip-modal__body" id="ip-modal-body" tabindex="-1" data-ip-modal-body>
      {%- comment -%} Content injected at runtime {%- endcomment -%}
    </div>
  </div>
</div>
