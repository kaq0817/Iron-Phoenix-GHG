{%- comment -%}
Domain-aware GA4 + GTM injector (Main + Baby store)
- ironphoenix.store        => GTM-TQD686VL / G-C6E01GLSZW
- ironphoenixghg.store     => GTM-MBXZB3HQ / G-630YS12KSN
If you’ve saved IDs in theme settings, those take priority.
{%- endcomment -%}

{%- assign host = request.host | downcase -%}

{%- assign gtm_main = settings.gtm_id | default: 'GTM-TQD686VL' -%}
{%- assign ga4_main = settings.ga4_id | default: 'G-C6E01GLSZW' -%}

{%- assign gtm_baby = settings.gtm_id_baby | default: 'GTM-MBXZB3HQ' -%}
{%- assign ga4_baby = settings.ga4_id_baby | default: 'G-630YS12KSN' -%}

{%- assign use_main = host contains 'ironphoenix.store' -%}
{%- assign gtm_id = use_main | default: false | if else: gtm_baby, gtm_main -%}
{%- assign ga4_id = use_main | default: false | if else: ga4_baby, ga4_main -%}

{%- if gtm_id != blank -%}
  <!-- Google Tag Manager -->
  <script>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
      var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
      j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','{{ gtm_id }}');
  </script>
  <!-- End GTM -->
{%- endif -%}

{%- if ga4_id != blank -%}
  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga4_id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config','{{ ga4_id }}');
  </script>
{%- endif -%}
