{%- comment -%}
  brand-tokens.liquid — attribute-only
  Resolves brand (setting override > host fallback) and sets <html data-brand="...">.
{%- endcomment -%}

{%- assign brand = settings.brand_variant -%}
{%- if brand == blank -%}
  {%- assign host = request.host | downcase -%}
  {%- if host contains 'ironphoenixghg.store' or host contains 'ironphoenixghg' -%}
    {%- assign brand = 'customs' -%}
  {%- elsif host contains 'ironphoenix.store' or host contains 'ironphoenix' -%}
    {%- assign brand = 'gamer' -%}
  {%- else -%}
    {%- assign brand = 'gamer' -%}
  {%- endif -%}
{%- endif -%}

<script>
  // Set data-brand early so brand-tokens.css rules apply
  document.documentElement.setAttribute('data-brand', {{ brand | json }});
</script>
