{%- comment -%}
Minimal social icons list (uses theme settings)
- Keys: facebook_url, instagram_url, twitter_url, pinterest_url, youtube_url
- Safe href escaping; opens in new tab; a11y labels
- Renders a single list only if at least one URL is set
{%- endcomment -%}

{%- assign facebook  = settings.facebook_url  -%}
{%- assign instagram = settings.instagram_url -%}
{%- assign twitter   = settings.twitter_url   -%}
{%- assign pinterest = settings.pinterest_url -%}
{%- assign youtube   = settings.youtube_url   -%}

{%- assign any_link = false -%}
{%- if facebook or instagram or twitter or pinterest or youtube -%}{%- assign any_link = true -%}{%- endif -%}

{%- if any_link -%}
<ul class="list-social list-unstyled" role="list">
  {%- if facebook != blank -%}
    <li><a href="{{ facebook | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">Facebook</a></li>
  {%- endif -%}
  {%- if instagram != blank -%}
    <li><a href="{{ instagram | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">Instagram</a></li>
  {%- endif -%}
  {%- if twitter != blank -%}
    <li><a href="{{ twitter | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Twitter / X">Twitter</a></li>
  {%- endif -%}
  {%- if pinterest != blank -%}
    <li><a href="{{ pinterest | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">Pinterest</a></li>
  {%- endif -%}
  {%- if youtube != blank -%}
    <li><a href="{{ youtube | escape }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">YouTube</a></li>
  {%- endif -%}
</ul>
{%- endif -%}
