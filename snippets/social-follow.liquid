{%- comment -%}
Minimal social icons list (portable, settings-driven, a11y-friendly)
- Prefers *_url keys (your current snippet), falls back to Dawn-style social_*_link keys
- Safe href escaping; opens in new tab with noopener/noreferrer
{%- endcomment -%}

{%- assign facebook  = settings.facebook_url  | default: settings.social_facebook_link  -%}
{%- assign instagram = settings.instagram_url | default: settings.social_instagram_link -%}
{%- assign twitter   = settings.twitter_url   | default: settings.social_twitter_link   -%}
{%- assign tiktok    = settings.tiktok_url    | default: settings.social_tiktok_link    -%}
{%- assign pinterest = settings.pinterest_url | default: settings.social_pinterest_link -%}
{%- assign youtube   = settings.youtube_url   | default: settings.social_youtube_link   -%}

<ul class="list-social list-unstyled" role="list">
  {%- if facebook != blank -%}
    <li><a href="{{ facebook | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">Facebook</a></li>
  {%- endif -%}

  {%- if instagram != blank -%}
    <li><a href="{{ instagram | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">Instagram</a></li>
  {%- endif -%}

  {%- if twitter != blank -%}
    <li><a href="{{ twitter | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Twitter / X">Twitter</a></li>
  {%- endif -%}

  {%- if tiktok != blank -%}
    <li><a href="{{ tiktok | escape }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok">TikTok</a></li>
  {%- endif -%}

  {%- if pinterest != blank -%}
    <li><a href="{{ pinterest | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">Pinterest</a></li>
  {%- endif -%}

  {%- if youtube != blank -%}
    <li><a href="{{ youtube | escape }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">YouTube</a></li>
  {%- endif -%}
</ul>
